# ===========================================
# DigiLog Repo-Root .env
# Copy to .env and update DATABASE_URL.
# ===========================================
# This file is read ONLY by `npx prisma` CLI commands run from the repo root
# (e.g. `npx prisma db push`, `npx prisma generate`). The Fastify API at
# apps/api/ reads its OWN .env (see apps/api/.env.example).

DATABASE_URL=postgresql://digilog:CHANGE_ME@localhost:5432/digilog_db?schema=public
