# Dependencies
node_modules/
apps/*/node_modules/

# Build outputs
dist/
apps/*/dist/
packages/*/dist/
# Precompiled DB seed (esbuild output of prisma/seed.ts; regenerated by
# scripts/build-bundle.ps1 for the customer runtime — never hand-edit/commit).
apps/api/prisma/seed.mjs

# Turbo
.turbo/

# Environment files
.env
apps/*/.env
apps/*/.env.backup-*

# IDE
.vscode/
.idea/

# Misc
*.log
.DS_Store
nul

# NSSM service runtime artifacts (per-machine; install-services-phase5.ps1
# pins the NSSM exe path here so subsequent runs find the same one).
nssm-path.txt
logs/


# Sensitive files - NEVER track
.env.production
# apps/web/.env.production is intentionally tracked: it holds ONLY VITE_API_URL,
# a PUBLIC build-time value baked into client JS (never a secret). Blank = the
# APK prompts for the server address at runtime (M8). Other .env.production stay ignored.
!apps/web/.env.production
.env.staging
.env.*.local
CREDENTIALS.md
*.pem
*.key
# Android signing keystores — never commit (untracked 2026-07-04 audit;
# rfid_scan_app/app/build.gradle.kts reads ../rfid-key.jks locally for release signing).
*.jks
*.keystore
# Backup snapshots of any file (audit-relevant: schema.prisma.bak
# would let `prisma db push` overwrite live schema from a stale snapshot).
*.bak

# Playwright MCP session traces (regenerated each run)
.playwright-mcp/

# Git worktrees (isolated subagent workspaces)
.worktrees/

# Claude Code permission allowlist backups (timestamped on cleanup)
.claude/settings.local.json.backup-*

# CodeGraph local index (per-machine SQLite + cache)
.codegraph/

# Root-level test/QA screenshot droppings (bug-fix-*.png, bug-sweep-*.png,
# mt-removal-*.png, step1-*.png, step6-e2e-*.png, tour-*.png, etc.).
# Anchored to repo root with leading "/" — tracked PNGs in
# PROJECT_HANDOVER/diagrams/, apps/, RFID/, old/screenshots/ are unaffected.
/*.png

# Old/local backup snapshots (pg_dump outputs, etc.)
/backups/

# Mosquitto dynamic-security: contains bcrypt hashes after first
# /refresh-acl call, never commit. Use mosquitto/dynamic-security.json.example
# as the bootstrap (the installer copies it on first run).
mosquitto/dynamic-security.json
mosquitto/dynamic-security.json.tmp

# Android Gradle build outputs (RFID scanner standalone app).
# Tracked-by-mistake before 2026-05-16 cleanup; ~558 files untracked then.
# Each build regenerates these — never commit.
RFID/app/build/
RFID/.gradle/

# Compiled Android packages. The intentional archive under old/apks/ is
# whitelisted below so it stays tracked.
*.apk
*.aab
!old/apks/*.apk
!DigiLog-FilterOps.apk

# Temporary test/debug artifacts (.tmp_* convention used by maintenance
# scripts that dump user state, wipe SQL, password-history snapshots, etc.)
/.tmp_*
/APPLICATION_REPORT.md

# mkcert accidentally creates a nested certs/certs/ dir if you run it
# from the certs/ folder — duplicate of the parent. Never commit.
certs/certs/

# Per-machine MCP config (ANDROID_HOME path is user-specific). Each dev
# generates their own; see reference_mobile_mcp_install memory.
/.mcp.json

# Local DB dumps must never be committed — they hold bcrypt password hashes,
# audit-trail PII, and the full data set (audit 2026-05-30).
old/db-backups/*
