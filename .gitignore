# Dependencies
node_modules/
apps/*/node_modules/

# Build outputs
dist/
apps/*/dist/
packages/*/dist/
# Precompiled DB seed (esbuild output of prisma/seed.ts; regenerated by
# scripts/build-bundle.ps1 for the customer runtime — never hand-edit/commit).
apps/api/prisma/seed.mjs

# Turbo
.turbo/

# Environment files
.env
apps/*/.env
apps/*/.env.backup-*

# IDE
.vscode/
.idea/

# Misc
*.log
.DS_Store
nul

logs/


# Sensitive files - NEVER track
.env.production
# apps/web/.env.production is intentionally tracked: it holds ONLY VITE_API_URL,
# a PUBLIC build-time value baked into client JS (never a secret). Tracked blank;
# the SPA is served same-origin by the API. Other .env.production stay ignored.
!apps/web/.env.production
.env.staging
.env.*.local
CREDENTIALS.md
*.pem
*.key
# Backup snapshots of any file (audit-relevant: schema.prisma.bak
# would let `prisma db push` overwrite live schema from a stale snapshot).
*.bak

# Playwright MCP session traces (regenerated each run)
.playwright-mcp/

# Git worktrees (isolated subagent workspaces)
.worktrees/

# Claude Code permission allowlist backups (timestamped on cleanup)
.claude/settings.local.json.backup-*

# CodeGraph local index (per-machine SQLite + cache)
.codegraph/

# Root-level test/QA screenshot droppings (bug-fix-*.png, bug-sweep-*.png,
# step1-*.png, tour-*.png, etc.). Anchored to repo root with leading "/" —
# tracked PNGs under Layouts/, PROJECT_HANDOVER/diagrams/, apps/ are unaffected.
# The 2026-08-31 QC mockup that sat here as "QC Layout.png" was moved to
# Layouts/CWH/mockups/ and tracked on 2026-10-05 (audit DOCS-18).
/*.png

# Old/local backup snapshots (pg_dump outputs, etc.)
/backups/

# Temporary test/debug artifacts (.tmp_* convention used by maintenance
# scripts that dump user state, wipe SQL, password-history snapshots, etc.)
/.tmp_*
/APPLICATION_REPORT.md

# mkcert accidentally creates a nested certs/certs/ dir if you run it
# from the certs/ folder — duplicate of the parent. Never commit.
certs/certs/


# Per-machine MCP config — each dev generates their own.
/.mcp.json

# Local DB dumps must never be committed — they hold bcrypt password hashes,
# audit-trail PII, and the full data set (audit 2026-05-30).
old/db-backups/*

# DigiLog-era debug artifacts (compliance-core strip)
/*.log

# Uploaded content — profile photos, branding, floorplan images. Written at
# runtime under UPLOADS_ROOT (apps/api/uploads by default, UPLOAD_DIR on a
# customer install). Operator data, not source; a floor layout in particular
# should not end up in the repo.
apps/api/uploads/

# Audit 2026-10-03 (DOCS-2, DOCS-17): a git worktree under .claude/ was committed as a
# dangling submodule gitlink, and vitest writes PDFs into apps/web/ that were tracked.
.claude/worktrees/
apps/web/*.pdf

# Pruned 2026-10-05 (audit DOCS-18): rules for mosquitto/, RFID/, *.apk, *.aab,
# *.jks, *.keystore and nssm-path.txt — none of those paths or build chains
# exist in this fork (`ls -d mosquitto RFID` -> neither).
