{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "apps/android/**",
    "**/dist/**",
    "**/build/**",
    ".claude/**",
    "tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/*.config.ts",
    "**/*.config.mjs",
    "**/*.mjs"
  ],
  "ignoreBinaries": [".*"],
  "ignoreDependencies": [".*"],
  "workspaces": {
    "apps/api": { "entry": ["src/app.ts!"], "project": "src/**/*.ts" },
    "apps/web": { "entry": ["src/main.tsx!", "index.html"], "project": "src/**/*.{ts,tsx}" },
    "packages/shared": { "entry": ["src/index.ts!"], "project": "src/**/*.ts" },
    "packages/queue": { "entry": ["src/index.ts!"], "project": "src/**/*.ts" }
  }
}
