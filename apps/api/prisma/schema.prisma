}

// (ReportTemplateStatus + ReportStatus enums removed 2026-07-04 with the
// orphaned reports generate/sign models.)

// ─── Report generate/sign models (ReportTemplate, ReportTemplateVersion,
// ReportInstance, ReportSignature) removed 2026-07-04 with the orphaned
// reports module. ReportReview (below) is the ACTIVE ad-hoc review workflow. ──

// 3-stage review/approval workflow for AD-HOC PDF exports (Audit Trail, Filters,
// Cleaning Cycles, etc. — generated via lib/pdf-report.ts). Because those reports
// aren't otherwise persisted, "Send for Review" snapshots the rendered data here
// so the reviewer/approver act on the exact content, and any later download
// rebuilds the same PDF with Printed By / Reviewed By / Approved By.
enum ReportReviewStatus {
  PENDING_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@map("report_review_status")
}

model ReportReview {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportType      String             @map("report_type") @db.VarChar(100) // reportKey (lib/report-types.ts)
  title           String             @db.VarChar(500)
  subtitle        String?            @db.VarChar(1000)
  // Frozen snapshot of the rendered report: { orientation, columnStyles?, sections:[{title?, head, body}] }.
  dataSnapshot    Json               @map("data_snapshot") @db.JsonB
  status          ReportReviewStatus @default(PENDING_REVIEW)

  // Stage 1 — generated (Printed By). *Name fields store the User ID (username).
  generatedBy     String             @map("generated_by") @db.Uuid
  generatedByName String             @map("generated_by_name") @db.VarChar(255)
  generatedAt     DateTime           @default(now()) @map("generated_at") @db.Timestamptz

  // Current-stage assignee — a specific user OR a whole role.
  assigneeUserId  String?            @map("assignee_user_id") @db.Uuid
  assigneeRole    String?            @map("assignee_role") @db.VarChar(50)

  // Stage 2 — reviewed (Reviewed By).
  reviewedBy      String?            @map("reviewed_by") @db.Uuid
  reviewedByName  String?            @map("reviewed_by_name") @db.VarChar(255)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz
  reviewRemarks   String?            @map("review_remarks") @db.Text

  // Stage 3 — approved (Approved By).
  approvedBy      String?            @map("approved_by") @db.Uuid
  approvedByName  String?            @map("approved_by_name") @db.VarChar(255)
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz
  approvalRemarks String?            @map("approval_remarks") @db.Text

  // Rejection (either stage).
  rejectionStage  String?            @map("rejection_stage") @db.VarChar(20) // REVIEW | APPROVAL
  rejectedBy      String?            @map("rejected_by") @db.Uuid
  rejectedByName  String?            @map("rejected_by_name") @db.VarChar(255)
  rejectedAt      DateTime?          @map("rejected_at") @db.Timestamptz

  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([assigneeUserId])
  @@index([assigneeRole])
  @@index([generatedBy])
  @@map("report_reviews")
}

// =============================================
// CLEANING STAGE INTERLOCK (QA approval gate)
// =============================================
// Two-point quality interlock inside a cleaning cycle. After WASH_OUT and after
// DRY_OUT the cycle pauses; the filter context is snapshotted and routed to a
// configurable approver role for a re-authenticated (digital-signature) decision.
//  - APPROVE → filter continues per the pinned cleaning-profile graph.
//  - REJECT  → currentLifecycleState moves back to rejectToStateKey (WASH_IN / DRY_IN).
// Gate rule: an operator may LEAVE an interlock stage only if the LATEST approval
// row for (cycleId, stageKey) is APPROVED. attemptSeq disambiguates reject→redo
// loops so a stale prior-attempt APPROVED cannot release a fresh attempt.
// No Prisma relations (mirrors ReportReview) — cycleId/filterId stored as raw Uuid.
enum CleaningStageApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  // Closed WITHOUT a decision: the filter left the gated stage before the
  // approver acted, so approve/reject are permanently unsafe (assertFilterStillAtGate
  // 409s). Set lazily by stageApprovalService.queue(). Appended last — ALTER TYPE
  // ADD VALUE appends in PG, and a mid-list order here reads as drift.
  SUPERSEDED

  @@map("cleaning_stage_approval_status")
}

model CleaningStageApproval {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId          String                      @map("cycle_id") @db.Uuid
  filterId         String                      @map("filter_id") @db.Uuid
  stageKey         String                      @map("stage_key") @db.VarChar(40) // WASH_OUT | DRY_OUT
  status           CleaningStageApprovalStatus @default(PENDING)
  approverRole     String                      @map("approver_role") @db.VarChar(50)
  rejectToStateKey String                      @map("reject_to_state_key") @db.VarChar(40) // WASH_IN | DRY_IN
  attemptSeq       Int                         @default(1) @map("attempt_seq")
  // Frozen filter context for the approver:
  // { block, area, ahu, ahuType, micronSize, filterType, filterDimensions, filterSet }
  detailsSnapshot  Json                        @map("details_snapshot") @db.JsonB

  // Stage 1 — requested by the operator who completed the interlock stage.
  // *Name fields store the User ID (username), matching ReportReview convention.
  requestedBy      String                      @map("requested_by") @db.Uuid
  requestedByName  String                      @map("requested_by_name") @db.VarChar(255)
  requestedAt      DateTime                    @default(now()) @map("requested_at") @db.Timestamptz

  // Stage 2 — the approve/reject decision (the digital signature; reauth-gated).
  decidedBy        String?                     @map("decided_by") @db.Uuid
  decidedByName    String?                     @map("decided_by_name") @db.VarChar(255)
  decidedAt        DateTime?                   @map("decided_at") @db.Timestamptz
  decisionRemarks  String?                     @map("decision_remarks") @db.Text

  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([cycleId, stageKey])
  @@index([status, approverRole])
  @@index([filterId])
  @@map("cleaning_stage_approvals")
}
