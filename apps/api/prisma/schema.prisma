// Help Articles (version-controlled)
model HelpArticle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @unique @db.VarChar(100)
  title          String   @db.VarChar(200)
  content        String   @db.Text
  category       String   @db.VarChar(50)
  sortOrder      Int      @default(0) @map("sort_order")
  currentVersion Int      @default(1) @map("current_version")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  versions HelpArticleVersion[]

  @@map("help_articles")
}

// Help Article Versions
model HelpArticleVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  helpArticleId String   @map("help_article_id") @db.Uuid
  version       Int
  content       String   @db.Text
  changedBy     String   @map("changed_by") @db.VarChar(50)
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  helpArticle HelpArticle @relation(fields: [helpArticleId], references: [id], onDelete: Cascade)

  @@unique([helpArticleId, version])
  @@map("help_article_versions")
}

// (DataStream + DeadLetterQueue + IngestionSystemConfig models removed with data-ingestion removal.)

// ====== Notification Delivery Logs (Email/SMS) ======
enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  TELEGRAM
  WHATSAPP
  SLACK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
}

model NotificationLog {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel      NotificationChannel
  recipient    String                     @db.VarChar(500)
  subject      String?                    @db.VarChar(500)
  message      String
  templateId   String?                    @map("template_id") @db.VarChar(100)
  status       NotificationDeliveryStatus @default(PENDING)
  retryCount   Int                        @default(0) @map("retry_count")
  maxRetries   Int                        @default(3) @map("max_retries")
  nextRetryAt  DateTime?                  @map("next_retry_at") @db.Timestamptz
  errorMessage String?                    @map("error_message")
  metadata     Json?                      @db.JsonB
  triggeredBy  String?                    @map("triggered_by") @db.VarChar(100) // system | manual (historic rows may contain 'rule-chain'/'alarm' — inert strings, no decoder)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  sentAt       DateTime?                  @map("sent_at") @db.Timestamptz

  @@index([channel])
  @@index([status])
  @@index([recipient])
  @@index([createdAt(sort: Desc)])
  @@map("notification_logs")
}

model NotificationTemplate {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String              @unique @db.VarChar(100)
  channel      NotificationChannel
  subject      String?             @db.VarChar(500)
  bodyTemplate String              @map("body_template")
  description  String?             @db.VarChar(500)
  variables    Json?               @db.JsonB // list of available variables
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?             @map("created_by") @db.VarChar(50)

  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
}

// ─── Notification Event Types ─────────────────────────────────────────
enum NotificationEventType {
  DEVICE_ONLINE
  DEVICE_OFFLINE
  DEVICE_INACTIVITY
  USER_LOGIN
  USER_CREATED
  USER_LOCKED
  CHECKLIST_SUBMITTED
  CHECKLIST_APPROVED
  CHECKLIST_REJECTED
  SYSTEM_ERROR
}

// ─── User Groups ──────────────────────────────────────────────────────
model UserGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.VarChar(50)

  members        UserGroupMember[]
  ruleRecipients NotificationRuleRecipient[]

  @@map("user_groups")
}

model UserGroupMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("user_group_members")
}

// ─── Notification Rules ───────────────────────────────────────────────
model NotificationRule {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                  @db.VarChar(200)
  description String?                 @db.VarChar(500)
  eventType   NotificationEventType   @map("event_type")
  eventTypes  NotificationEventType[] @default([]) @map("event_types")

  // Filtering conditions (JSONB): e.g. {"severity": ["CRITICAL","MAJOR"]}
  conditions Json @default("{}") @db.JsonB

  // Channels
  emailEnabled Boolean @default(false) @map("email_enabled")
  smsEnabled   Boolean @default(false) @map("sms_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")

  // Template references
  emailTemplateId String? @map("email_template_id") @db.Uuid
  smsTemplateId   String? @map("sms_template_id") @db.Uuid

  // Throttling
  cooldownMinutes Int @default(0) @map("cooldown_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.VarChar(50)

  recipients NotificationRuleRecipient[]

  @@index([eventType])
  @@index([isActive])
  @@index([isActive, priority(sort: Desc)])
  @@map("notification_rules")
}

model NotificationRuleRecipient {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId        String  @map("rule_id") @db.Uuid
  recipientType String  @map("recipient_type") @db.VarChar(20) // ROLE | GROUP | USER
  roleValue     String? @map("role_value") @db.VarChar(50)
  groupId       String? @map("group_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid

  rule  NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  group UserGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@map("notification_rule_recipients")
}

// ─── Phase 2: Filter Management System ─────────────────────













// Quality Notification registry. One row per PM-schedule action (upload / review /
// approve / reject / resubmit). The qnn (QN-YYYY-000001, from the qnn_seq sequence)
// is the human-facing reference number surfaced in the Notifications center. Soft
// refs (no FK cascade) so the audit record survives entry/schedule deletion.


// ─── Filter Replacement Schedule (upload-driven, 2026-06-02) ───────────────
// Additive feature: a user uploads a schedule (one ReplacementSchedule batch);
// each row becomes a ReplacementScheduleEntry (AHU + filter spec + qty + date +
// ± tolerance window). Due entries surface as tablet My-Tasks; each filter
// actually replaced is logged as a ReplacementExecution (qty tracking + audit).
// AHU is a soft ref (no FK) to avoid coupling to the asset/typed-filter tables.
// The execute step WRAPS the existing replace action — it does not change it.




// ─── PM Overdue Deviations (2026-06-03) ───────────────────────────────────
// When a PM cleaning task (PmScheduleEntry) passes its tolerance window without
// all of the AHU's counted filters cleaned, the overdue sweep opens ONE
// Deviation per entry (UNIQUE pm_schedule_entry_id → no daily duplicates). The
// ROW IS THE STATE MACHINE: OPEN → ACKNOWLEDGED (operator confirms with password
// on My Tasks) → CLOSED (all filters cleaned afterwards). Notifications fire once
// per transition, guarded by notified_at / completion_notified_at. Soft refs (no
// FK) — like ReplacementSchedule — so the deviation audit record survives
// schedule/entry deletion (21 CFR). Created via psql DDL (db push blocked).






// Step 4 (2026-05-02): join table replacing FilterProfile.applicableTemplates
// JSONB array. Both FKs cascade-delete so a vanishing AssetTemplate or
// FilterProfile takes its bindings with it — no more dangling UUIDs in JSON.
// Server-side guard in template.service blocks AssetTemplate delete with
// 409 IN_USE if any FilterProfile still binds it; the cascade is the safety
// net, not the operator-visible path.

// Immutable historical snapshot of a FilterProfile at a specific version.
// Written BEFORE every mutation to the live profile (snapshot-then-bump, Phase A.3).
// FilterProfile drift cannot affect in-flight cycles because cycles already
// pin `cleaning_cycles.profileId` to a specific FilterCleaningProfile row at
// start, so no cycle-side pin map is needed here — versions exist purely for
// audit replay and admin history.



// ─── Equipment Groups ──────────────────────────────────────


// Immutable historical snapshot of an EquipmentGroup at a specific version.
// Written BEFORE every mutation to the live group or any of its instruments
// (snapshot-then-bump, Phase A.4). The composite (group + 3 instruments) is
// always snapshotted together because update() mutates them as a unit.


// ─── Checklist Profiles & Questions ──────────────────────────




// Immutable historical snapshot of a checklist profile at a specific version.
// Created BEFORE every mutation to the live profile or its questions (snapshot-then-bump).
// Cycles store a pin map { profileId: versionNumber } and resolve questions through here
// so answers always reproduce against the schema that was active when the cycle started.



// (ReportTemplateStatus + ReportStatus enums removed 2026-07-04 with the
// orphaned reports generate/sign models.)

// ─── Report generate/sign models (ReportTemplate, ReportTemplateVersion,
// ReportInstance, ReportSignature) removed 2026-07-04 with the orphaned
// reports module. ReportReview (below) is the ACTIVE ad-hoc review workflow. ──

// 3-stage review/approval workflow for AD-HOC PDF exports (Audit Trail, Filters,
// Cleaning Cycles, etc. — generated via lib/pdf-report.ts). Because those reports
// aren't otherwise persisted, "Send for Review" snapshots the rendered data here
// so the reviewer/approver act on the exact content, and any later download
// rebuilds the same PDF with Printed By / Reviewed By / Approved By.


// =============================================
// CLEANING STAGE INTERLOCK (QA approval gate)
// =============================================
// Two-point quality interlock inside a cleaning cycle. After WASH_OUT and after
// DRY_OUT the cycle pauses; the filter context is snapshotted and routed to a
// configurable approver role for a re-authenticated (digital-signature) decision.
//  - APPROVE → filter continues per the pinned cleaning-profile graph.
//  - REJECT  → currentLifecycleState moves back to rejectToStateKey (WASH_IN / DRY_IN).
// Gate rule: an operator may LEAVE an interlock stage only if the LATEST approval
// row for (cycleId, stageKey) is APPROVED. attemptSeq disambiguates reject→redo
// loops so a stale prior-attempt APPROVED cannot release a fresh attempt.
// No Prisma relations (mirrors ReportReview) — cycleId/filterId stored as raw Uuid.

// =============================================
// DATA INJECTION LAYER — P1 FOUNDATION
// =============================================
// Industrial IoT hierarchy (HierarchyNode), protocol registry (Protocol),
// reusable connection configs (CommunicationProfile), gateway/instrument
// device registry, and per-instrument settings/topic overrides.
//
// `path ltree` is deliberately absent from HierarchyNode below: Prisma maps
// ltree to Unsupported(), which would make the whole model unselectable
// through the typed client. The column is added by raw SQL in the migration
// and read/written only through hierarchy.repository.ts (Task 5).

enum HierarchyLevel {
  COMPANY
  SITE
  PLANT
  BUILDING
  BLOCK
  AREA
  LINE
}

enum TopicCategory {
  TELEMETRY
  ATTRIBUTES
  ALARM
  COMMAND
  RPC
  HEARTBEAT
  EVENT
  STATUS
  CONFIG
  RESPONSE
  SETTINGS
  PUBLISH
  SUBSCRIBE
}

model HierarchyNode {
  id        String         @id @default(uuid())
  parentId  String?        @map("parent_id")
  level     HierarchyLevel
  name      String
  slug      String
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by")

  parent    HierarchyNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  HierarchyNode[] @relation("NodeTree")
  gateways    Gateway[]
  instruments Instrument[]

  @@unique([parentId, slug])
  @@index([level])
  @@map("hierarchy_nodes")
}

model Protocol {
  key          String  @id
  name         String
  isEnabled    Boolean @default(false) @map("is_enabled")
  capabilities Json
  profiles     CommunicationProfile[]
  @@map("protocols")
}

model CommunicationProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  protocolKey String   @map("protocol_key")
  config      Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")

  protocol    Protocol     @relation(fields: [protocolKey], references: [key], onDelete: Restrict)
  gateways    Gateway[]
  instruments Instrument[]
  @@map("communication_profiles")
}

model Gateway {
  id                     String   @id @default(uuid())
  name                   String
  code                   String   @unique
  slug                   String
  gatewayType            String   @map("gateway_type")
  externalId             String   @map("external_id")
  hierarchyNodeId        String   @map("hierarchy_node_id")
  communicationProfileId String   @map("communication_profile_id")
  description            String?
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  createdBy              String?  @map("created_by")

  hierarchyNode HierarchyNode        @relation(fields: [hierarchyNodeId], references: [id], onDelete: Restrict)
  profile       CommunicationProfile @relation(fields: [communicationProfileId], references: [id], onDelete: Restrict)
  instruments   Instrument[]

  @@unique([hierarchyNodeId, slug])
  @@index([hierarchyNodeId])
  @@map("gateways")
}

model Instrument {
  id                     String   @id @default(uuid())
  name                   String
  code                   String   @unique
  slug                   String
  instrumentType         String   @map("instrument_type")
  manufacturer           String?
  model                  String?
  serialNumber           String?  @map("serial_number")
  description            String?
  hierarchyNodeId        String   @map("hierarchy_node_id")
  gatewayId              String?  @map("gateway_id")
  deviceKey              String?  @map("device_key")
  communicationProfileId String?  @map("communication_profile_id")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  createdBy              String?  @map("created_by")

  hierarchyNode HierarchyNode         @relation(fields: [hierarchyNodeId], references: [id], onDelete: Restrict)
  gateway       Gateway?              @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  profile       CommunicationProfile? @relation(fields: [communicationProfileId], references: [id], onDelete: Restrict)
  setting       InstrumentSetting?
  topics        InstrumentTopic[]

  @@unique([gatewayId, deviceKey])
  @@unique([hierarchyNodeId, slug])
  @@index([gatewayId])
  @@map("instruments")
}

model InstrumentSetting {
  instrumentId String     @id @map("instrument_id")
  values       Json
  updatedAt    DateTime   @updatedAt @map("updated_at")
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  @@map("instrument_settings")
}

model InstrumentTopic {
  id           String        @id @default(uuid())
  instrumentId String        @map("instrument_id")
  category     TopicCategory
  customTopic  String?       @map("custom_topic")
  qos          Int           @default(1)
  retain       Boolean       @default(false)
  enabled      Boolean       @default(true)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  @@unique([instrumentId, category])
  @@map("instrument_topics")
}

