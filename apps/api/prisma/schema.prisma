model PmScheduleEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId    String   @map("schedule_id") @db.Uuid
  month         Int
  plannedDate   DateTime @map("planned_date") @db.Date
  toleranceDays Int      @default(0) @map("tolerance_days")
  windowStart   DateTime @map("window_start") @db.Date
  windowEnd     DateTime @map("window_end") @db.Date
  notes         String?

  // QA approval workflow
  approvalStatus  PmEntryApprovalStatus @default(PENDING) @map("approval_status")
  approvalRemarks String?               @map("approval_remarks")
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedByName  String?               @map("approved_by_name") @db.VarChar(255)
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz
  submittedBy     String?               @map("submitted_by") @db.Uuid
  submittedByName String?               @map("submitted_by_name") @db.VarChar(255)

  // 3-step workflow tracking (review step + reject attribution).
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedByName  String?   @map("reviewed_by_name") @db.VarChar(255)
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  reviewRemarks   String?   @map("review_remarks")
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectedByName  String?   @map("rejected_by_name") @db.VarChar(255)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz
  rejectionStage  String?   @map("rejection_stage") @db.VarChar(20) // REVIEW | APPROVAL

  // Pending edit (approved value stays active while edit awaits QA)
  pendingPlannedDate   DateTime? @map("pending_planned_date") @db.Date
  pendingToleranceDays Int?      @map("pending_tolerance_days")
  pendingEditBy        String?   @map("pending_edit_by") @db.Uuid
  pendingEditAt        DateTime? @map("pending_edit_at") @db.Timestamptz

  manualEntry Boolean @default(false) @map("manual_entry") // manual data-mgmt insert

  schedule   PmSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  executions PmExecution[]

  @@unique([scheduleId, month])
  @@index([scheduleId])
  @@index([windowStart, windowEnd])
  @@index([approvalStatus])
  @@map("pm_schedule_entries")
}

// Quality Notification registry. One row per PM-schedule action (upload / review /
// approve / reject / resubmit). The qnn (QN-YYYY-000001, from the qnn_seq sequence)
// is the human-facing reference number surfaced in the Notifications center. Soft
// refs (no FK cascade) so the audit record survives entry/schedule deletion.
model QualityNotification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qnn               String   @unique @db.VarChar(40)
  action            String   @db.VarChar(40)
