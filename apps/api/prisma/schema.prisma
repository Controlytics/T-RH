generator client {
  provider = "prisma-client-js"
  // `native` = the machine running `prisma generate` (Windows here). The two
  // Linux targets are for the Ubuntu .deb (scripts/linux/build-deb.sh): the
  // engine for openssl 1.1 (Ubuntu 20.04) and openssl 3.0 (22.04 and later)
  // both ship, and Prisma picks one at runtime by probing the host. Harmless on
  // Windows beyond a one-time download at generate.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssigneeType {
  USER
  ROLE
}

// Organization — logical grouping under a tenant
// Template Assignment — maps templates to users for visibility

// Entity Assignment — controls which users can access which entities

// =============================================
// DASHBOARD MODELS
// =============================================

// Dashboard — container for widgets
model Dashboard {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  layout      Json     @default("{}") @db.JsonB // Grid layout config
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid

  widgets     DashboardWidget[]
  assignments DashboardAssignment[]

  @@index([isActive])
  @@map("dashboards")
}

// Dashboard Widget — individual widget on a dashboard
model DashboardWidget {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardId     String   @map("dashboard_id") @db.Uuid
  widgetType      String   @map("widget_type") @db.VarChar(50) // timeseries_chart, gauge, value_card, etc.
  title           String   @db.VarChar(200)
  config          Json     @default("{}") @db.JsonB // Widget-specific configuration
  position        Json     @default("{\"x\":0,\"y\":0,\"w\":4,\"h\":3}") @db.JsonB // {x, y, w, h}
  dataSource      Json     @default("{}") @map("data_source") @db.JsonB // {entityIds, telemetryKeys, aggregation, timeWindow}
  refreshInterval Int      @default(30) @map("refresh_interval") // seconds, 0 = real-time via WebSocket
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

// Dashboard Assignment — who can see which dashboard
model DashboardAssignment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardId  String       @map("dashboard_id") @db.Uuid
  assigneeType AssigneeType @map("assignee_type")
  userId       String?      @map("user_id") @db.Uuid
  roleValue    String?      @map("role_value") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([userId])
  @@map("dashboard_assignments")
}

// Dynamic Role model - allows Super Admin to add/manage roles
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique @db.VarChar(50) // e.g., "SUPER_ADMIN", "ADMIN"
  displayName    String   @map("display_name") @db.VarChar(100) // e.g., "Super Admin", "Admin"
  description    String?  @db.VarChar(500)
  hierarchyLevel Int      @map("hierarchy_level") // Higher = more privileges (6 for SUPER_ADMIN)
  permissions    Json     @default("[]") @db.JsonB // Array of permission strings
  color          String   @default("#6366f1") @db.VarChar(100) // Badge color for UI (CSS class)
  isSystem       Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.VarChar(50)
  updatedBy      String?  @map("updated_by") @db.VarChar(50)

  @@index([hierarchyLevel])
  @@index([isActive])
  @@map("roles")
}

enum UserStatus {
  ENABLED
  DISABLED
  LOCKED
  EXPIRED
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String     @unique @db.VarChar(50)
  fullName            String     @map("full_name") @db.VarChar(100)
  email               String?    @unique @db.VarChar(100)
  passwordHash        String     @map("password_hash")
  department          String?    @db.VarChar(50)
  photoUrl            String?    @map("photo_url") @db.VarChar(500)
  role                String     @db.VarChar(50) // References roles.name
  status              UserStatus @default(ENABLED)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?  @map("locked_at") @db.Timestamptz
  lockoutUntil        DateTime?  @map("lockout_until") @db.Timestamptz
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz
  passwordExpiresAt   DateTime?  @map("password_expires_at") @db.Timestamptz
  forcePasswordChange Boolean    @default(true) @map("force_password_change")
  isTemporaryPassword Boolean    @default(true) @map("is_temporary_password")
  authSource          String     @default("local") @map("auth_source") @db.VarChar(10)
  ldapDn              String?    @map("ldap_dn")
  lastLogin           DateTime?  @map("last_login") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String?    @map("created_by") @db.VarChar(50)
  updatedBy           String?    @map("updated_by") @db.VarChar(50)

  passwordHistory     PasswordHistory[]
  sessions            Session[]

  // (Report generate/sign relations removed 2026-07-04 with the orphaned module.)

  @@index([role])
  @@index([status])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Session {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt      DateTime @default(now()) @map("last_active_at") @db.Timestamptz
  expiresAt         DateTime @map("expires_at") @db.Timestamptz
  terminationReason String?  @map("termination_reason") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("sessions")
}

model SystemConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey      String   @unique @map("config_key") @db.VarChar(100)
  configValue    Json     @map("config_value")
  configType     String   @map("config_type") @db.VarChar(50)
  requiresReauth Boolean  @default(false) @map("requires_reauth")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.VarChar(50)

  @@map("system_config")
}

model FieldIdConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId     String   @unique @map("field_id") @db.VarChar(50)
  defaultName String   @map("default_name") @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.VarChar(50)

  @@map("field_id_config")
}

model PasswordResetRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  status      String    @default("PENDING") @db.VarChar(20)
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  processedBy String?   @map("processed_by") @db.VarChar(50)
  notes       String?

  @@map("password_reset_requests")
}

model AdminRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType         String    @map("request_type") @db.VarChar(30) // CREATE_USER, MODIFY_USER, UNLOCK, FORGOT_PASSWORD
  status              String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  requesterName       String    @map("requester_name") @db.VarChar(100)
  requesterEmployeeId String?   @map("requester_employee_id") @db.VarChar(50)
  requesterEmail      String?   @map("requester_email") @db.VarChar(100)
  requestData         Json      @default("{}") @map("request_data") @db.JsonB // Type-specific form data
  remarks             String?   @db.VarChar(500) // Requester's reason
  adminRemarks        String?   @map("admin_remarks") @db.VarChar(500) // Admin notes on approve/reject
  processedBy         String?   @map("processed_by") @db.VarChar(100)
  manualEntry         Boolean   @default(false) @map("manual_entry") // manual data-mgmt insert
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt         DateTime? @map("processed_at") @db.Timestamptz

  @@index([status])
  @@index([requestType])
  @@index([requestedAt(sort: Desc)])
  @@map("admin_requests")
}

model AuditTrail {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp        DateTime @default(now()) @db.Timestamptz
  userId           String?  @map("user_id") @db.VarChar(100)
  userName         String?  @map("user_name") @db.VarChar(100)
  userRole         String?  @map("user_role") @db.VarChar(50)
  action           String   @db.VarChar(100)
  targetType       String?  @map("target_type") @db.VarChar(50)
  targetId         String?  @map("target_id") @db.VarChar(255)
  beforeValue      Json?    @map("before_value")
  afterValue       Json?    @map("after_value")
  reason           String?
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent")
  sessionId        String?  @map("session_id") @db.VarChar(100)
  checksum         String   @db.VarChar(64)
  // Checksum formula version. NULL = legacy unkeyed SHA-256 (V1/V2, all rows
  // written before the keyed-chain cutover). 3 = keyed HMAC-SHA256 (V3) written
  // when AUDIT_CHAIN_KEY is set. The verifier REQUIRES the key + an HMAC match
  // for version-3 rows (never accepts the unkeyed formula for them), so a
  // DB-level actor cannot forge or downgrade a keyed row. See lib/hash-chain.ts.
  checksumVersion  Int?     @map("checksum_version") @db.SmallInt
  // Audit 2026-05-04 fix C3: tamper-evident hash chain. Each new row carries
  // the prior row's checksum (under a Postgres advisory lock during write so
  // the chain is monotonic across concurrent writers). Existing rows written
  // before the migration carry NULL — they are the "pre-chain" era and are
  // verified by per-row checksum only. New rows verify both per-row +
  // chain link via apps/api/src/lib/audit-verify.ts.
  previousChecksum String?  @map("previous_checksum") @db.VarChar(64)
  // Monotonically-incrementing position assigned at insert time. Sort key
  // for chain verification (timestamp can collide at sub-millisecond on
  // batched writes; chainPosition can't). bigserial-equivalent.
  chainPosition    BigInt?  @default(autoincrement()) @map("chain_position")
  signatureMeaning String?  @map("signature_meaning") @db.VarChar(255)
  // Audit 2026-05-20 §C1 / May 16 §1.2 fix: 21 CFR §11.10(e)-compliant
  // REDACTION path replaces physical DELETE. When set, beforeValue + afterValue
  // are NULLed but checksum + chainPosition + previousChecksum are preserved
  // so the chain stays intact. verifyAuditChecksum() treats redactedAt != null
  // rows as "valid: redacted" rather than recomputing the per-row checksum
  // (which would no longer match after payload was NULLed).
  redactedAt       DateTime? @map("redacted_at") @db.Timestamptz
  redactedBy       String?   @map("redacted_by") @db.VarChar(100)
  redactionReason  String?   @map("redaction_reason")

  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([sessionId])
  @@index([userId, timestamp(sort: Desc)])
  @@index([chainPosition])
  @@map("audit_trail")
}

// Notification types for user alerts
enum NotificationType {
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_APPROVED
  PASSWORD_RESET_REJECTED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  USER_CREATION_REQUEST_SUBMITTED
  USER_CREATION_REQUEST_APPROVED
  USER_CREATION_REQUEST_REJECTED
  DEVICE_ONLINE
  DEVICE_OFFLINE
  DEVICE_INACTIVITY
  USER_LOGIN
  USER_LOCKED
  SYSTEM_ERROR
  // Report review/approval workflow — 2026-06-11
  REPORT_REVIEW_REQUESTED
  REPORT_REVIEW_APPROVED
  REPORT_REVIEW_REJECTED
  // Password expiry warnings — per-user daily warning window + expiry notice (2026-07-08)
  PASSWORD_EXPIRY_WARNING
  PASSWORD_EXPIRED_NOTICE
}

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(200)
  message      String           @db.VarChar(1000)
  targetUserId String?          @map("target_user_id") @db.VarChar(50) // The user this notification is about
  forUserId    String?          @map("for_user_id") @db.VarChar(50) // The user who should see this (null = admins)
  forRole      String?          @map("for_role") @db.VarChar(50) // Role that should see this notification
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at") @db.Timestamptz
  metadata     Json?            @db.JsonB // Additional context data
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?          @map("created_by") @db.VarChar(50)
  manualEntry  Boolean          @default(false) @map("manual_entry") // manual data-mgmt insert

  @@index([forUserId])
  @@index([forRole])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@index([forUserId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// User-specific sidebar and feature configuration
model UserConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  sidebarItems Json     @default("[]") @map("sidebar_items") @db.JsonB // Array of enabled sidebar items
  homeWidgets  Json     @default("[]") @map("home_widgets") @db.JsonB // Array of enabled home widgets
  permissions  Json     @default("{}") @map("permissions") @db.JsonB // Feature-level permissions
  /// Instrument visibility by functional location. NULL = inherit (user -> role ->
  /// unrestricted); [] = SEE NOTHING; [ids] = these locations, Blocks expanding to
  /// their Areas. Nullable with NO default so this cannot blind existing roles.
  instrumentScope Json? @map("instrument_scope") @db.JsonB
  /// Which dashboard / trend-page panels this user may SEE, overriding their role.
  /// NULL = inherit; [] = NO panels; [keys] = these panels. Same three states as
  /// role_configs.dashboard_cards, and the empty list must never be read as
  /// inherit.
  dashboardCards Json? @map("dashboard_cards") @db.JsonB
  /// This user's own dashboard arrangement. NULL = use their role's default,
  /// then the built-in. See role_configs.dashboard_layout for why this is two
  /// states rather than three. NOT audited: it is a personal preference, and a
  /// hash-chained §11 trail filling with "moved a card 40px left" is one in which
  /// real records get harder to find.
  dashboardLayout Json? @map("dashboard_layout") @db.JsonB
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.VarChar(50)

  @@map("user_configs")
}

// Role-based default configuration
model RoleConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         String   @unique @db.VarChar(50) // References roles.name
  sidebarItems Json     @default("[]") @map("sidebar_items") @db.JsonB
  homeWidgets  Json     @default("[]") @map("home_widgets") @db.JsonB
  permissions  Json     @default("{}") @map("permissions") @db.JsonB
  /// Instrument visibility by functional location. NULL = inherit (user -> role ->
  /// unrestricted); [] = SEE NOTHING; [ids] = these locations, Blocks expanding to
  /// their Areas. Nullable with NO default so this cannot blind existing roles.
  instrumentScope Json? @map("instrument_scope") @db.JsonB
  /// Which instrument attributes this role may change:
  /// `{ mode: ALL_EDIT|ALL_VIEW|SELECTED, keys: [], requireReauth: bool }`.
  /// NULL = inherit, i.e. exactly the pre-2026-08-19 behaviour (editable iff the
  /// role holds INSTRUMENT_UPDATE). Nullable with NO default so shipping this
  /// cannot freeze an existing role out of its own work.
  attributeAccess Json? @map("attribute_access") @db.JsonB
  /// Which dashboard / trend-page panels this role may SEE. NULL = inherit
  /// (user -> role -> every panel); [] = NO panels; [keys] = these panels.
  /// Nullable with NO default: a default of '[]' would blank every existing
  /// role's dashboard the moment this migration ran.
  /// A hidden panel is a DISPLAY decision, NOT an access control — instrument_scope
  /// is what restricts data. See @digilog/shared types/panels.ts.
  dashboardCards Json? @map("dashboard_cards") @db.JsonB
  /// The role's DEFAULT dashboard arrangement, which a user's own layout
  /// overrides. NULL = use the built-in default.
  /// TWO states, NOT the three dashboardCards uses above: an empty layout is not
  /// a meaningful instruction the way an empty panel list is a deliberate deny,
  /// so absent and unreadable both simply fall back. Do not unify the two rules.
  /// Layout is a PREFERENCE and grants nothing — dashboardCards decides what a
  /// user may see. Setting a ROLE default is audited; a user's own layout is not.
  dashboardLayout Json? @map("dashboard_layout") @db.JsonB
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.VarChar(50)

  @@map("role_configs")
}

// Help Articles (version-controlled)
model HelpArticle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @unique @db.VarChar(100)
  title          String   @db.VarChar(200)
  content        String   @db.Text
  category       String   @db.VarChar(50)
  sortOrder      Int      @default(0) @map("sort_order")
  currentVersion Int      @default(1) @map("current_version")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  versions HelpArticleVersion[]

  @@map("help_articles")
}

// Help Article Versions
model HelpArticleVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  helpArticleId String   @map("help_article_id") @db.Uuid
  version       Int
  content       String   @db.Text
  changedBy     String   @map("changed_by") @db.VarChar(50)
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  helpArticle HelpArticle @relation(fields: [helpArticleId], references: [id], onDelete: Cascade)

  @@unique([helpArticleId, version])
  @@map("help_article_versions")
}

// (DataStream + DeadLetterQueue + IngestionSystemConfig models removed with data-ingestion removal.)

// ====== Notification Delivery Logs (Email/SMS) ======
enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  TELEGRAM
  WHATSAPP
  SLACK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
}

model NotificationLog {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel      NotificationChannel
  recipient    String                     @db.VarChar(500)
  subject      String?                    @db.VarChar(500)
  message      String
  templateId   String?                    @map("template_id") @db.VarChar(100)
  status       NotificationDeliveryStatus @default(PENDING)
  retryCount   Int                        @default(0) @map("retry_count")
  maxRetries   Int                        @default(3) @map("max_retries")
  nextRetryAt  DateTime?                  @map("next_retry_at") @db.Timestamptz
  errorMessage String?                    @map("error_message")
  metadata     Json?                      @db.JsonB
  triggeredBy  String?                    @map("triggered_by") @db.VarChar(100) // system | manual (historic rows may contain 'rule-chain'/'alarm' — inert strings, no decoder)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  sentAt       DateTime?                  @map("sent_at") @db.Timestamptz

  @@index([channel])
  @@index([status])
  @@index([recipient])
  @@index([createdAt(sort: Desc)])
  @@map("notification_logs")
}

model NotificationTemplate {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String              @unique @db.VarChar(100)
  channel      NotificationChannel
  subject      String?             @db.VarChar(500)
  bodyTemplate String              @map("body_template")
  description  String?             @db.VarChar(500)
  variables    Json?               @db.JsonB // list of available variables
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?             @map("created_by") @db.VarChar(50)

  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
}

// ─── Notification Event Types ─────────────────────────────────────────
enum NotificationEventType {
  DEVICE_ONLINE
  DEVICE_OFFLINE
  DEVICE_INACTIVITY
  USER_LOGIN
  USER_CREATED
  USER_LOCKED
  SYSTEM_ERROR
  // 2026-08-14 (project C4). An excursion is not a device going offline: DEVICE_OFFLINE
  // says the instrument stopped talking, these say it reported a value outside its limit.
  ALARM_RAISED
  ALARM_CLEARED
}

// ─── User Groups ──────────────────────────────────────────────────────
model UserGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.VarChar(50)

  members        UserGroupMember[]
  ruleRecipients NotificationRuleRecipient[]

  @@map("user_groups")
}

model UserGroupMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("user_group_members")
}

// ─── Notification Rules ───────────────────────────────────────────────
model NotificationRule {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                  @db.VarChar(200)
  description String?                 @db.VarChar(500)
  eventType   NotificationEventType   @map("event_type")
  eventTypes  NotificationEventType[] @default([]) @map("event_types")

  // Filtering conditions (JSONB): e.g. {"severity": ["CRITICAL","MAJOR"]}
  conditions Json @default("{}") @db.JsonB

  // Channels
  emailEnabled Boolean @default(false) @map("email_enabled")
  smsEnabled   Boolean @default(false) @map("sms_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")

  // Template references
  emailTemplateId String? @map("email_template_id") @db.Uuid
  smsTemplateId   String? @map("sms_template_id") @db.Uuid

  // Throttling
  cooldownMinutes Int @default(0) @map("cooldown_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.VarChar(50)

  recipients NotificationRuleRecipient[]

  @@index([eventType])
  @@index([isActive])
  @@index([isActive, priority(sort: Desc)])
  @@map("notification_rules")
}

model NotificationRuleRecipient {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId        String  @map("rule_id") @db.Uuid
  recipientType String  @map("recipient_type") @db.VarChar(20) // ROLE | GROUP | USER
  roleValue     String? @map("role_value") @db.VarChar(50)
  groupId       String? @map("group_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid

  rule  NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  group UserGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  @@map("notification_rule_recipients")
}

// 3-stage review/approval workflow for AD-HOC PDF exports (Audit Trail, etc.
// — generated via lib/pdf-report.ts). Because those reports aren't otherwise
// persisted, "Send for Review" snapshots the rendered data here so the
// reviewer/approver act on the exact content, and any later download rebuilds
// the same PDF with Printed By / Reviewed By / Approved By.

// ─── Instruments (Data Injection P1) ───────────────────────────────────────

/// A named container for instruments.
///
/// A profile carries ONE inherited setting: `attributeKeys`, the list of
/// attribute keys the New Instrument form asks for in this profile. Profiles
/// inherit PROMPTS, never VALUES — nothing is ever back-filled onto an
/// instrument that already exists, and moving an instrument between profiles
/// changes only which keys are suggested, never its recorded attributes. See
/// `docs/superpowers/specs/2026-08-08-per-profile-instrument-attributes-design.md`.
///
/// Deleting a profile that still holds instruments is refused by the FOREIGN KEY
/// on `Instrument.profileId` (onDelete: Restrict), not merely by the service
/// check that produces the friendly message. A future code path that forgets the
/// check therefore still cannot orphan an instrument or destroy a populated
/// group.
model InstrumentProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  /// Newline-separated attribute keys, the same wire format as the global
  /// default template, so `parseInstrumentAttributeKeys` stays the one
  /// definition of what a line means.
  ///
  /// Three states: a non-empty string is this profile's own list; `''` means it
  /// asks for no attributes; NULL means never customised and falls back to the
  /// default template. NULL is a read-side safety net for a code path that
  /// forgets to seed — the migration backfills every existing row and POST
  /// seeds every new one, so it should not occur.
  attributeKeys String? @map("attribute_keys")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  instruments Instrument[]

  @@map("instrument_profiles")
}

/// A logical grouping of instruments: a two-level BLOCK > AREA tree.
///
/// AUTHORITATIVE grouping since 2026-08-13, replacing the free-text
/// `Instrument.block` / `.area` columns (which are kept for now but no longer read
/// for grouping). Each of the three groupings has one job and they must not be
/// confused: FunctionalLocation = logical grouping, `roomId` = geometry on a
/// drawn floorplan, `profileId` = device type.
///
/// Depth is capped at 2 and enforced in `functional-locations/validation.ts`: only
/// an AREA may carry a parent, and that parent must be a BLOCK.
/// A configurable alarm condition over instrument telemetry.
///
/// Rules are a SECOND definition of "out of spec", alongside the room limits that
/// drive the dashboard table and the floor plan. A rule may alarm at 24 while the
/// room's spec permits 25 — legitimate as an early warning, but it means the table can
/// show green while an alarm is active. Every Alarm therefore snapshots its rule, and
/// the UI names the rule that fired. See the design spec before changing this.

/// One raised alarm. A REGULATED RECORD: never edited beyond clearedAt and the three
/// acknowledgement fields, and never deleted.
model Alarm {
  id     String @id @default(uuid())
  /// NULL for an instrument-limit alarm: it is raised from the instrument's own
  /// attributes and has no rule row. Inventing a synthetic rule would put an
  /// editable row on the Alarm Rules page that silently disagrees with the
  /// attribute it came from.

  /// The rule AS IT WAS when this fired. Editing or deleting the rule must not change
  /// what a historical alarm says about itself — an inspector asking "why did this fire
  /// at 24.0 when the spec is 25.0?" is answered from here, not from the live rule.
  ruleSnapshot Json @map("rule_snapshot") @db.JsonB

  instrumentId String      @map("instrument_id")
  metric       AlarmMetric
  /// The reading that tripped it. NULL for OFFLINE, which has no value.
  triggeredValue Float?        @map("triggered_value")
  severity       AlarmSeverity
  state          AlarmState    @default(ACTIVE)

  /// What raised this. RULE alarms come from alarm_rules; INSTRUMENT_LIMIT alarms
  /// from the instrument's own limit attributes.
  source AlarmSource @default(RULE)

  /// Which bound was breached. NULL for rule alarms, which describe themselves
  /// through their snapshot instead.
  limitKind AlarmLimitKind? @map("limit_kind")

  /// The reading that brought it back in spec. NULL while still active, and for
  /// OFFLINE which has no value.
  clearedValue Float? @map("cleared_value")

  raisedAt  DateTime  @default(now()) @map("raised_at") @db.Timestamptz(3)
  clearedAt DateTime? @map("cleared_at") @db.Timestamptz(3)

  /// Acknowledgement is independent of clearing: a cleared-but-unacknowledged alarm is
  /// exactly the overnight excursion someone must still answer for in the morning.
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedBy    String?   @map("acknowledged_by")
  acknowledgeReason String?   @map("acknowledge_reason")

  /// Restrict on BOTH: an alarm is a regulated record, so deleting an instrument or a
  /// rule must not erase the history of what it did.
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  webhookDeliveries AlarmWebhookDelivery[]

  @@index([state, raisedAt(sort: Desc)])
  @@index([instrumentId, raisedAt(sort: Desc)])
  @@index([acknowledgedAt])
  @@index([source, instrumentId, metric, limitKind, state])
  /// DB-MANAGED UNIQUENESS, not expressible here: the partial unique index
  /// `alarms_active_instrument_limit_unique` on (instrument_id, metric, limit_kind)
  /// WHERE state = 'ACTIVE' AND source = 'INSTRUMENT_LIMIT' (migration
  /// 20260817120000_alarm_limit_unique_active). It stops two overlapping evaluation
  /// passes from both opening the same excursion — the loser of that race is
  /// unreachable by every code path and would stay ACTIVE for good. PARTIAL because
  /// many CLEARED rows for one bound are legitimate, one per excursion.
  /// `prisma migrate diff` proposes dropping it; do not accept that.
  ///
  /// SECOND DB-MANAGED PARTIAL UNIQUE INDEX, same category and same warning:
  /// `alarms_active_inactivity_unique` on (instrument_id)
  /// WHERE state = 'ACTIVE' AND source = 'INACTIVITY' (migration
  /// 20260831120000_inactivity_alarms). One open inactivity alarm per instrument —
  /// the pass reads its open set once and cannot see a row another process
  /// inserts mid-cycle. PARTIAL because many CLEARED rows for one instrument are
  /// legitimate, one per outage.
  @@map("alarms")
}

/// An IP hooter (or any HTTP endpoint) that is POSTed to when an alarm changes state.
/// Scoped to instruments the same way role_configs.instrument_scope is — functional
/// locations with Blocks expanding to their Areas, PLUS explicit instruments — so this
/// introduces no fourth grouping concept.
model AlarmWebhookTarget {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(200)
  description String? @db.VarChar(500)

  /// Operator-typed. NO allowlist: a hooter lives on the operator's LAN and any
  /// allowlist would have to contain it. Guards are the timeout, redirect:'error',
  /// and the delivery log — see the design's "Outbound-request stance".
  url    String @db.Text
  /// POST | PUT | GET. A validated string, not an enum, so the vocabulary can grow
  /// without a migration — same precedent as FloorplanRoom.grade.
  method String @default("POST") @db.VarChar(10)

  headers     Json   @default("{}") @map("headers") @db.JsonB
  contentType String @default("application/json") @map("content_type") @db.VarChar(100)
  /// ${...} placeholders. Rendered by render-body.ts, NOT by the notification
  /// template engine, which HTML-escapes and would corrupt JSON.
  bodyTemplate String @map("body_template") @db.Text

  /// When set, the response body MUST match this for the send to count as delivered,
  /// and it OVERRIDES the status code. Cheap hardware returns HTTP 200 on failure —
  /// the same lesson as SmsConfig.httpGatewaySuccessRegex (#sms-2xx).
  successRegex String? @map("success_regex") @db.Text
  timeoutMs    Int     @default(5000) @map("timeout_ms")

  fireOnRaised       Boolean @default(true) @map("fire_on_raised")
  fireOnCleared      Boolean @default(true) @map("fire_on_cleared")
  fireOnAcknowledged Boolean @default(true) @map("fire_on_acknowledged")

  /// NULL = every severity. ["CRITICAL","MAJOR"] narrows.
  severities Json? @db.JsonB
  /// Throttles RAISED ONLY. CLEARED and ACKNOWLEDGED are silence signals and are
  /// never suppressed — rate-limiting the off switch leaves a buzzer sounding for a
  /// condition that has already gone away.
  cooldownSeconds Int     @default(0) @map("cooldown_seconds")
  isActive        Boolean @default(true) @map("is_active")

  /// NOT NULL with a [] default, deliberately unlike role_configs.instrument_scope
  /// where NULL means "inherit". There is nothing to inherit from here, and [] must
  /// unambiguously mean NOTHING rather than being confusable with "unrestricted".
  scopeLocationIds   Json @default("[]") @map("scope_location_ids") @db.JsonB
  scopeInstrumentIds Json @default("[]") @map("scope_instrument_ids") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  deliveries AlarmWebhookDelivery[]

  @@index([isActive])
  @@map("alarm_webhook_targets")
}

/// One delivery attempt. The §11 evidence that the system did — or did not —
/// annunciate a specific excursion. Never edited, never deleted.
model AlarmWebhookDelivery {
  id       String  @id @default(uuid())
  targetId String  @map("target_id")
  /// NULL for a TEST fire, which has no alarm behind it.
  alarmId  String? @map("alarm_id")

  /// RAISED | CLEARED | ACKNOWLEDGED | TEST.
  event String @db.VarChar(20)
  /// Copied at send time: the target's URL may be edited afterwards, and this row
  /// must keep saying which URL was actually hit.
  url String @db.Text
  /// Stored verbatim. Small, and the only honest answer to "why didn't it fire" —
  /// re-rendering it later from a since-edited template would be a fabrication.
  requestBody     String  @map("request_body") @db.Text
  httpStatus      Int?    @map("http_status")
  responseSnippet String? @map("response_snippet") @db.VarChar(1000)
  attempt         Int
  /// SENT | FAILED.
  status String @db.VarChar(10)
  error  String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  /// RESTRICT on both: a delivery row is evidence about a regulated event, so
  /// deleting a target or an alarm must not erase the record of what it did.
  target AlarmWebhookTarget @relation(fields: [targetId], references: [id], onDelete: Restrict)
  alarm  Alarm?             @relation(fields: [alarmId], references: [id], onDelete: Restrict)

  @@index([targetId, createdAt(sort: Desc)])
  @@index([alarmId])
  @@index([status])
  @@map("alarm_webhook_deliveries")
}

/// A report REQUEST (2026-09-07): the frozen document (data_snapshot) plus who
/// asked, who was asked, and who decided. Every PDF download in the product is
/// such a request; the requester and the approver download the approved
/// document with both signatures. ONE transition only: PENDING -> APPROVED |
/// REJECTED. Never deleted — a §11 record. Design:
/// docs/superpowers/specs/2026-09-07-report-review-workflow-design.md
model ReportReview {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The audit reportType, e.g. 'Instrument Time Series'.
  reportType      String             @map("report_type") @db.VarChar(100)
  title           String             @db.VarChar(500)
  subtitle        String?            @db.VarChar(1000)
  /// { period:{from,to,label}, intervalMs?, instrumentCodes?, search? } — what the lists say.
  requestMeta     Json               @map("request_meta") @db.JsonB
  /// The frozen document (ReportSnapshot v2). THE record: draft and approved
  /// downloads both replay it, so what was reviewed is what is downloaded.
  dataSnapshot    Json               @map("data_snapshot") @db.JsonB
  status          ReportReviewStatus @default(PENDING)

  requestedBy     String             @map("requested_by") @db.Uuid
  /// The username — what the signature line prints.
  requestedByName String             @map("requested_by_name") @db.VarChar(255)
  /// The role held at the request — FROZEN, since the signature block prints it (2026-09-25).
  requestedByRole String?            @map("requested_by_role") @db.VarChar(50)
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz
  requestRemarks  String             @map("request_remarks") @db.Text

  /// Exactly one of the two — the requester's own choice, on rows raised
  /// before 2026-10-01. No longer written; the arrays below carry it.
  assigneeUserId  String?            @map("assignee_user_id") @db.Uuid
  assigneeRole    String?            @map("assignee_role") @db.VarChar(50)
  /// The APPROVERS, frozen from Configuration → Report Approvers at the request
  /// (2026-10-01): any holder of one of these roles, or any of these users.
  approverRoles   String[]           @default([]) @map("approver_roles") @db.VarChar(50)
  approverUserIds String[]           @default([]) @map("approver_user_ids") @db.Uuid
  /// The instruments the report is about (2026-10-01). A user sees the request
  /// only if their instrument scope covers ANY of them; empty = not scoped.
  instrumentIds   String[]           @default([]) @map("instrument_ids")

  decidedBy       String?            @map("decided_by") @db.Uuid
  decidedByName   String?            @map("decided_by_name") @db.VarChar(255)
  /// The role held at the decision — FROZEN (2026-09-25).
  decidedByRole   String?            @map("decided_by_role") @db.VarChar(50)
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz
  decisionRemarks String?            @map("decision_remarks") @db.Text

  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, assigneeUserId])
  @@index([status, assigneeRole])
  @@index([requestedBy, createdAt])
  @@index([approverRoles], type: Gin)
  @@index([instrumentIds], type: Gin)
  @@map("report_reviews")
}

enum AlarmMetric {
  TEMPERATURE
  HUMIDITY
  OFFLINE
}


enum AlarmSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum AlarmState {
  ACTIVE
  CLEARED
}

enum AlarmSource {
  RULE
  INSTRUMENT_LIMIT
  /// Raised automatically when an instrument stops reporting, cleared when it
  /// starts again. No rule row: like INSTRUMENT_LIMIT it is derived from the
  /// instrument itself, so every instrument is covered without anyone authoring
  /// anything — including one with no functional location, which a
  /// location-targeted OFFLINE rule could never reach.
  INACTIVITY
  /// Raised when a sensor reports a NON-NUMERIC value (`NA`, `ERR`, a quoted
  /// number) on a temperature or humidity slot key, cleared when it reports a
  /// number again. The RS485 probe or its bus has failed while the logger keeps
  /// talking, so INACTIVITY cannot see it (`last_seen_at` is stamped) and
  /// INSTRUMENT_LIMIT cannot either (a non-numeric reading is discarded before
  /// the comparison, and a null is deliberately not a breach).
  RS485_FAILURE
  /// Raised when a reading falls outside the probe's own declared measuring span
  /// (`High/Low Temperature Range` attributes) — saturated or faulty hardware, as
  /// distinct from INSTRUMENT_LIMIT, which is a genuine product excursion. While
  /// one is open the reading is treated as NO READING: it raises no limit alarm
  /// and cannot clear one.
  SENSOR_RANGE
}

/// Report review workflow (2026-09-07). One transition: PENDING -> APPROVED | REJECTED.
enum ReportReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("report_review_status")
}

enum AlarmLimitKind {
  HIGH
  LOW
}

model FunctionalLocation {
  id       String                 @id @default(uuid())
  name     String
  type     FunctionalLocationType
  /// NULL for a BLOCK, required for an AREA.
  parentId String?                @map("parent_id")
  /// Manual display order among siblings, lowest first; ties break on name.
  ///
  /// DEFAULT 0 means "unordered", which is why every existing row keeps the
  /// exact alphabetical order it had before this column existed — 0 ties
  /// everywhere, and the name tiebreak decides. Nothing moves until someone
  /// actually arranges them.
  ///
  /// Ordering is PER PARENT, not global: Blocks are ordered among Blocks, and
  /// each Block's Areas among themselves. A single global sequence would mean
  /// inserting one Block renumbered every Area in the plant.
  sortOrder Int                   @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  parent      FunctionalLocation?  @relation("FlTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    FunctionalLocation[] @relation("FlTree")
  instruments Instrument[]

  /// Unique per parent, so two Blocks may each own an "QC" area. NOTE: Postgres
  /// treats NULLs as DISTINCT, so this does NOT make top-level Block names
  /// unique — that check lives in the service layer.
  @@unique([parentId, name])
  @@index([type])
  /// The list and tree queries both read siblings in (parentId, sortOrder, name)
  /// order; without this the reorder screen table-scans on every render.
  @@index([parentId, sortOrder])
  @@map("functional_locations")
}

enum FunctionalLocationType {
  BLOCK
  AREA
}

model Instrument {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  // No `transport` column by design: a credential authenticates on any
  // listener (`resolveInstrumentByToken` never checks protocol), so storing one
  // asserted a constraint nothing enforced. `dead_letters.transport` — how a
  // payload actually ARRIVED — is a different, observed fact and is retained.
  isActive            Boolean  @default(true) @map("is_active")
  instrumentType      String?  @map("instrument_type")
  manufacturer        String?
  model               String?
  serialNumber        String?  @map("serial_number")
  description         String?
  expectedIntervalSec Int?     @map("expected_interval_sec")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy           String?  @map("created_by")

  // Placement — free text by design (spec D8). No lookup tables, no admin
  // screens; `code` remains the unique identifier and the MQTT topic segment.
  location            String?  @map("location")
  area                String?  @map("area")
  block               String?  @map("block")

  // Gateway model. `gatewayId` IS the authorisation rule: a gateway may write
  // instrument X iff X.gatewayId = gateway.id. One comparison, no link table.
  isGateway           Boolean  @default(false) @map("is_gateway")
  gatewayId           String?  @map("gateway_id")

  // Last-seen lives on the INSTRUMENT, not on its credential: a child reported
  // through its gateway never presents its own credential, so a
  // credential-based column would read "Never" for exactly the instruments the
  // gateway feature exists to serve.
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastSeenVia         String?   @map("last_seen_via")

  // Every instrument belongs to exactly one profile. NOT NULL: rows predating
  // profiles were backfilled to "Default" by migration 20260808120000, so there
  // is no "unassigned" state to handle anywhere in the code.
  profileId String            @map("profile_id")
  profile   InstrumentProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  credentials InstrumentCredential[]
  attributes  InstrumentAttribute[]

  gateway  Instrument?  @relation("GatewayChildren", fields: [gatewayId], references: [id], onDelete: SetNull)
  children Instrument[] @relation("GatewayChildren")

  // Which room this instrument physically sits in.
  //
  // NULLABLE by design — an unplaced instrument is a normal state, and the
  // dashboard shows those in an explicit "not placed" tray rather than dropping
  // them silently. A real FK rather than matching the free-text `location`
  // column above, because room membership must not be breakable by a typo or a
  // trailing space. `location` stays exactly what it was: descriptive text.
  roomId String?        @map("room_id")
  room   FloorplanRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  /// The instrument's functional location. ONE nullable FK on purpose: "an
  /// instrument in one functional location cannot be linked to another" is a
  /// one-to-many, so two locations is unrepresentable rather than forbidden by a
  /// rule someone has to remember. Restrict, so deleting a location with
  /// instruments fails loudly instead of orphaning them.
  functionalLocationId String?             @map("functional_location_id")
  functionalLocation   FunctionalLocation? @relation(fields: [functionalLocationId], references: [id], onDelete: Restrict)
  alarms     Alarm[]

  @@index([gatewayId])
  @@index([profileId])
  @@index([block, area, location])
  @@index([roomId])
  @@index([functionalLocationId])
  @@map("instruments")
}

model InstrumentCredential {
  id           String    @id @default(uuid())
  instrumentId String    @map("instrument_id")
  tokenHash    String    @map("token_hash")
  tokenPrefix  String    @map("token_prefix")
  /// AES-256-GCM `iv:authTag:ciphertext` of the plaintext token, so an operator
  /// can be shown the credential (reverses spec D5 — see token-crypto.ts).
  /// NULLABLE ON PURPOSE: credentials issued before 2026-08-06, and any issued
  /// while no INSTRUMENT_TOKEN_KEY is configured, have none and are simply
  /// unviewable. Authentication reads `tokenHash` and never this column.
  tokenEncrypted String? @map("token_encrypted")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([tokenPrefix])
  @@index([instrumentId])
  @@map("instrument_credentials")
}

/// Free-form operator-recorded facts about an instrument — calibration due date,
/// asset tag, vendor contract, whatever the site tracks.
///
/// A CHILD TABLE, not a JSONB column on `instruments`, for two reasons:
///   1. `@@unique([instrumentId, key])` makes "set this attribute" idempotent at
///      the storage layer. A JSONB blob has no such constraint and a merge bug
///      shows up as silently duplicated or lost keys.
///   2. Each change is audited individually, naming the key and both values.
///      An attribute may hold a calibration date — a §11 record — and
///      "who changed it, from what, to what" must be answerable without diffing
///      two opaque blobs.
model InstrumentAttribute {
  id           String   @id @default(uuid())
  instrumentId String   @map("instrument_id")
  /// Trimmed and sanitised before storage; never empty. It is also the URL
  /// segment for the edit/delete endpoints.
  key          String
  value        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, key])
  @@index([key])
  @@map("instrument_attributes")
}

model InstrumentTelemetryLatest {
  instrumentId String   @map("instrument_id")
  key          String
  value        Json
  valueType    String   @map("value_type")
  ts           DateTime @db.Timestamptz(6)

  @@id([instrumentId, key])
  @@index([instrumentId])
  @@map("instrument_telemetry_latest")
}

model DeadLetter {
  id           String   @id @default(uuid())
  instrumentId String?  @map("instrument_id")
  transport    String
  reason       String
  rawPayload   String?  @map("raw_payload")
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([receivedAt])
  @@map("dead_letters")
}


/// A floor layout image with clickable rooms drawn on it.
///
/// Several plans coexist — one per floor or block — and the dashboard shows one
/// at a time. The image is uploaded through the normal uploads module; nothing
/// here parses a PDF or extracts geometry. The rooms that matter are the ones
/// with instruments in them, and those are placed by hand in the editor.
model Floorplan {
  id          String   @id @default(uuid())
  name        String   @unique
  /// NULL for a plan drawn from a blank canvas in the Layout Designer
  /// (2026-09-22); `imageWidth`/`imageHeight` then hold the chosen CANVAS size
  /// (the aspect the plan is drawn at), not an image's pixels.
  imagePath   String?  @map("image_path")
  imageWidth  Int      @map("image_width")
  imageHeight Int      @map("image_height")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  /// Everything on the plan that is NOT a room: `{ equipment, hvac, water,
  /// airflow, labels }`. Each entry carries coordinates normalized 0..1 against
  /// the plan, the same convention as `FloorplanRoom.x/y/w/h`, so the whole
  /// drawing scales together and nothing detaches at a different zoom.
  ///
  /// NULL = a plan with no annotation layer, which is every generated plan and
  /// every row predating this column. The dashboard draws the legend only when
  /// this is present, so a plan that annotates nothing gets no legend for
  /// symbols it does not use.
  ///
  /// These are STATIC drawing content. Nothing here senses anything: an HVAC
  /// symbol is where a unit is drawn, not a unit that reports.
  annotations Json?

  rooms FloorplanRoom[]
  links FloorplanRoomLink[]

  @@map("floorplans")
}

/// One clickable region of a plan, and the environmental specification that
/// region must hold.
///
/// LIMITS LIVE HERE, NOT ON THE INSTRUMENT. A cleanroom's specification belongs
/// to the room: replacing the probe on its wall must not discard the spec, and
/// two probes in one room must not be able to assert two different specs. This
/// reverses the four `* Temperature/Humidity Limit` instrument-attribute keys
/// introduced 2026-08-08 — see
/// docs/superpowers/specs/2026-08-11-instrument-dashboard-floorplan-design.md §3.
model FloorplanRoom {
  id          String  @id @default(uuid())
  floorplanId String  @map("floorplan_id")
  /// The room code as it appears on the drawing, e.g. "CWH-I/142".
  code        String
  label       String?

  /// Normalized 0..1 against the plan image, NOT pixels: the hotspot then holds
  /// at any zoom and any screen size, and survives re-exporting the drawing at a
  /// different DPI. Bounds are enforced in floorplans/validation.ts rather than
  /// by CHECK constraints, so a bad payload returns a 400 naming the offending
  /// field instead of an opaque constraint error the UI cannot explain.
  x Float
  y Float
  w Float
  h Float

  /// NULL = that bound is not checked. All four NULL is legitimate — a corridor
  /// or an office has no environmental specification.
  tempMin Float? @map("temp_min")
  tempMax Float? @map("temp_max")
  rhMin   Float? @map("rh_min")
  rhMax   Float? @map("rh_max")

  /// Doors as drawn on the plan: an array of
  /// `{ wall, offset, width, kind }`, each normalized against ITS WALL so the
  /// door stays attached when the room is moved or resized. NULL = nobody has
  /// drawn doors for this room yet, which is the honest state of every row that
  /// predates the column. Validated in floorplans/validation.ts, never by a
  /// CHECK constraint, so a bad payload names its offending field.
  ///
  /// Static geometry only. Nothing in this install senses a door.
  doors Json?

  /// Cleanroom-grade classification: one of A / B / C / D / CIRCULATION /
  /// UTILITY. NULL = nobody has classified this room, which renders it white
  /// exactly as before this column existed. TEXT with zod validation rather
  /// than a Postgres enum, so the classification vocabulary can be extended
  /// without a migration and the enum count stays at 13.
  grade String?

  /// What the DRAWING says about this room that the schema has no other home
  /// for: `{ fill, fch, dims }` — the room's fill colour as drawn, its finished
  /// ceiling height ("2.7m") and its floor dimensions ("4993 x 2534"), both free
  /// text because they are transcribed from a drawing, not computed.
  ///
  /// NULL = this room came from the generator, not a drawing, and renders
  /// exactly as it did before this column existed. `fill` OVERRIDES the grade
  /// hue: a traced plan reproduces the draughtsman's own colour coding, which
  /// says what a room is FOR, while `grade` goes on carrying the cleanroom
  /// classification for everything that reads it. The two are not the same
  /// statement and neither replaces the other.
  ///
  /// Json rather than three columns, and TEXT rather than numbers, for the same
  /// reason `doors` and `grade` are: the vocabulary of a drawing grows, and a
  /// migration per annotation is a tax on transcribing one.
  meta Json?

  /// The room's outline as corners `[{x, y}, …]` in plan units 0..1, drawn
  /// order, closing edge implied (Layout Designer, 2026-09-22). NULL = a
  /// rectangle, whose outline IS `x/y/w/h` — every room drawn before this
  /// column and every room the trace scripts write. When present, `x/y/w/h`
  /// are the polygon's BOUNDING BOX, derived by the server on every write, so
  /// every reader that needs only a box is untouched. Validated in
  /// floorplans/validation.ts through @digilog/shared's `validatePolygon`.
  points Json?

  linksFrom FloorplanRoomLink[] @relation("linkFrom")
  linksTo   FloorplanRoomLink[] @relation("linkTo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  floorplan   Floorplan    @relation(fields: [floorplanId], references: [id], onDelete: Cascade)
  instruments Instrument[]

  @@unique([floorplanId, code])
  @@index([floorplanId])
  @@map("floorplan_rooms")
}

/// A relation the drawing states between two rooms of one plan (Layout
/// Designer, 2026-09-22). `kind` is a validated string, not a Postgres enum
/// (the `grade` precedent): OPENING = a gap in the wall the two rooms share,
/// on `fromRoom`'s edge `fromEdge` at `offset`/`width` (fractions of that edge)
/// with an optional door leaf `door` (ENTRY | EXIT | PASSAGE); CONNECTOR = a
/// drawn line between two rooms that do not touch, optionally labelled. The
/// dashboard mirrors an OPENING onto the neighbour's edge at render time
/// (`mirrorOpening`), so only one side is stored. Cascades with either room.
model FloorplanRoomLink {
  id          String   @id @default(uuid())
  floorplanId String   @map("floorplan_id")
  fromRoomId  String   @map("from_room_id")
  toRoomId    String   @map("to_room_id")
  kind        String
  fromEdge    Int?     @map("from_edge")
  offset      Float?
  width       Float?
  door        String?
  label       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  floorplan Floorplan     @relation(fields: [floorplanId], references: [id], onDelete: Cascade)
  fromRoom  FloorplanRoom @relation("linkFrom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoom    FloorplanRoom @relation("linkTo", fields: [toRoomId], references: [id], onDelete: Cascade)

  @@index([floorplanId])
  @@map("floorplan_room_links")
}
