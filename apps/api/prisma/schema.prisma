generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssigneeType {
  USER
  ROLE
}

// Organization — logical grouping under a tenant
// Template Assignment — maps templates to users for visibility
model TemplateAssignment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId   String       @map("template_id") @db.Uuid
  assigneeType AssigneeType @map("assignee_type")
  userId       String?      @map("user_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?      @map("created_by") @db.VarChar(50)

  template AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User?         @relation("UserTemplateAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([userId])
  @@map("template_assignments")
}

// Entity Assignment — controls which users can access which entities
model EntityAssignment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId     String       @map("entity_id") @db.Uuid
  assigneeType AssigneeType @map("assignee_type")
  userId       String?      @map("user_id") @db.Uuid
  roleValue    String?      @map("role_value") @db.VarChar(50)
  permissions  Json         @default("{\"view\":true,\"control\":false,\"configure\":false}") @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?      @map("created_by") @db.VarChar(50)

  entity AssetInstance @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user   User?         @relation("UserEntityAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([userId])
  @@map("entity_assignments")
}

// =============================================
// DASHBOARD MODELS
// =============================================

// Dashboard — container for widgets
model Dashboard {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  layout      Json     @default("{}") @db.JsonB // Grid layout config
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid

  widgets     DashboardWidget[]
  assignments DashboardAssignment[]

  @@index([isActive])
  @@map("dashboards")
}

// Dashboard Widget — individual widget on a dashboard
model DashboardWidget {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardId     String   @map("dashboard_id") @db.Uuid
  widgetType      String   @map("widget_type") @db.VarChar(50) // timeseries_chart, gauge, value_card, etc.
  title           String   @db.VarChar(200)
  config          Json     @default("{}") @db.JsonB // Widget-specific configuration
  position        Json     @default("{\"x\":0,\"y\":0,\"w\":4,\"h\":3}") @db.JsonB // {x, y, w, h}
  dataSource      Json     @default("{}") @map("data_source") @db.JsonB // {entityIds, telemetryKeys, aggregation, timeWindow}
  refreshInterval Int      @default(30) @map("refresh_interval") // seconds, 0 = real-time via WebSocket
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

// Dashboard Assignment — who can see which dashboard
model DashboardAssignment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardId  String       @map("dashboard_id") @db.Uuid
  assigneeType AssigneeType @map("assignee_type")
  userId       String?      @map("user_id") @db.Uuid
  roleValue    String?      @map("role_value") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([userId])
  @@map("dashboard_assignments")
}

// Dynamic Role model - allows Super Admin to add/manage roles
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique @db.VarChar(50) // e.g., "SUPER_ADMIN", "ADMIN"
  displayName    String   @map("display_name") @db.VarChar(100) // e.g., "Super Admin", "Admin"
  description    String?  @db.VarChar(500)
  hierarchyLevel Int      @map("hierarchy_level") // Higher = more privileges (6 for SUPER_ADMIN)
  permissions    Json     @default("[]") @db.JsonB // Array of permission strings
  color          String   @default("#6366f1") @db.VarChar(100) // Badge color for UI (CSS class)
  isSystem       Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.VarChar(50)
  updatedBy      String?  @map("updated_by") @db.VarChar(50)

  @@index([hierarchyLevel])
  @@index([isActive])
  @@map("roles")
}

enum UserStatus {
  ENABLED
  DISABLED
  LOCKED
  EXPIRED
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String     @unique @db.VarChar(50)
  fullName            String     @map("full_name") @db.VarChar(100)
  email               String?    @unique @db.VarChar(100)
  passwordHash        String     @map("password_hash")
  department          String?    @db.VarChar(50)
  photoUrl            String?    @map("photo_url") @db.VarChar(500)
  role                String     @db.VarChar(50) // References roles.name
  status              UserStatus @default(ENABLED)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?  @map("locked_at") @db.Timestamptz
  lockoutUntil        DateTime?  @map("lockout_until") @db.Timestamptz
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz
  passwordExpiresAt   DateTime?  @map("password_expires_at") @db.Timestamptz
  forcePasswordChange Boolean    @default(true) @map("force_password_change")
  isTemporaryPassword Boolean    @default(true) @map("is_temporary_password")
  authSource          String     @default("local") @map("auth_source") @db.VarChar(10)
  ldapDn              String?    @map("ldap_dn")
  lastLogin           DateTime?  @map("last_login") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String?    @map("created_by") @db.VarChar(50)
  updatedBy           String?    @map("updated_by") @db.VarChar(50)

  passwordHistory     PasswordHistory[]
  sessions            Session[]
  templateAssignments TemplateAssignment[] @relation("UserTemplateAssignments")
  entityAssignments   EntityAssignment[]   @relation("UserEntityAssignments")

  // (Report generate/sign relations removed 2026-07-04 with the orphaned module.)

  @@index([role])
  @@index([status])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Session {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt      DateTime @default(now()) @map("last_active_at") @db.Timestamptz
  expiresAt         DateTime @map("expires_at") @db.Timestamptz
  terminationReason String?  @map("termination_reason") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("sessions")
}

model SystemConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey      String   @unique @map("config_key") @db.VarChar(100)
  configValue    Json     @map("config_value")
  configType     String   @map("config_type") @db.VarChar(50)
  requiresReauth Boolean  @default(false) @map("requires_reauth")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.VarChar(50)

  @@map("system_config")
}

model FieldIdConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId     String   @unique @map("field_id") @db.VarChar(50)
  defaultName String   @map("default_name") @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.VarChar(50)

  @@map("field_id_config")
}

model PasswordResetRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  status      String    @default("PENDING") @db.VarChar(20)
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  processedBy String?   @map("processed_by") @db.VarChar(50)
  notes       String?

  @@map("password_reset_requests")
}

model AdminRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType         String    @map("request_type") @db.VarChar(30) // CREATE_USER, MODIFY_USER, UNLOCK, FORGOT_PASSWORD
  status              String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  requesterName       String    @map("requester_name") @db.VarChar(100)
  requesterEmployeeId String?   @map("requester_employee_id") @db.VarChar(50)
  requesterEmail      String?   @map("requester_email") @db.VarChar(100)
  requestData         Json      @default("{}") @map("request_data") @db.JsonB // Type-specific form data
  remarks             String?   @db.VarChar(500) // Requester's reason
  adminRemarks        String?   @map("admin_remarks") @db.VarChar(500) // Admin notes on approve/reject
  processedBy         String?   @map("processed_by") @db.VarChar(100)
  manualEntry         Boolean   @default(false) @map("manual_entry") // manual data-mgmt insert
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt         DateTime? @map("processed_at") @db.Timestamptz

  @@index([status])
  @@index([requestType])
  @@index([requestedAt(sort: Desc)])
  @@map("admin_requests")
}

model AuditTrail {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp        DateTime @default(now()) @db.Timestamptz
  userId           String?  @map("user_id") @db.VarChar(100)
  userName         String?  @map("user_name") @db.VarChar(100)
  userRole         String?  @map("user_role") @db.VarChar(20)
  action           String   @db.VarChar(100)
  targetType       String?  @map("target_type") @db.VarChar(50)
  targetId         String?  @map("target_id") @db.VarChar(255)
  beforeValue      Json?    @map("before_value")
  afterValue       Json?    @map("after_value")
  reason           String?
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent")
  sessionId        String?  @map("session_id") @db.VarChar(100)
  checksum         String   @db.VarChar(64)
  // Checksum formula version. NULL = legacy unkeyed SHA-256 (V1/V2, all rows
  // written before the keyed-chain cutover). 3 = keyed HMAC-SHA256 (V3) written
  // when AUDIT_CHAIN_KEY is set. The verifier REQUIRES the key + an HMAC match
  // for version-3 rows (never accepts the unkeyed formula for them), so a
  // DB-level actor cannot forge or downgrade a keyed row. See lib/hash-chain.ts.
  checksumVersion  Int?     @map("checksum_version") @db.SmallInt
  // Audit 2026-05-04 fix C3: tamper-evident hash chain. Each new row carries
  // the prior row's checksum (under a Postgres advisory lock during write so
  // the chain is monotonic across concurrent writers). Existing rows written
  // before the migration carry NULL — they are the "pre-chain" era and are
  // verified by per-row checksum only. New rows verify both per-row +
  // chain link via apps/api/src/lib/audit-verify.ts.
  previousChecksum String?  @map("previous_checksum") @db.VarChar(64)
  // Monotonically-incrementing position assigned at insert time. Sort key
  // for chain verification (timestamp can collide at sub-millisecond on
  // batched writes; chainPosition can't). bigserial-equivalent.
  chainPosition    BigInt?  @default(autoincrement()) @map("chain_position")
  signatureMeaning String?  @map("signature_meaning") @db.VarChar(255)
  // Audit 2026-05-20 §C1 / May 16 §1.2 fix: 21 CFR §11.10(e)-compliant
  // REDACTION path replaces physical DELETE. When set, beforeValue + afterValue
  // are NULLed but checksum + chainPosition + previousChecksum are preserved
  // so the chain stays intact. verifyAuditChecksum() treats redactedAt != null
  // rows as "valid: redacted" rather than recomputing the per-row checksum
  // (which would no longer match after payload was NULLed).
  redactedAt       DateTime? @map("redacted_at") @db.Timestamptz
  redactedBy       String?   @map("redacted_by") @db.VarChar(100)
  redactionReason  String?   @map("redaction_reason")

  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([sessionId])
  @@index([userId, timestamp(sort: Desc)])
  @@index([chainPosition])
  @@map("audit_trail")
}

// Notification types for user alerts
enum NotificationType {
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_APPROVED
  PASSWORD_RESET_REJECTED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  USER_CREATION_REQUEST_SUBMITTED
  USER_CREATION_REQUEST_APPROVED
  USER_CREATION_REQUEST_REJECTED
  DEVICE_ONLINE
  DEVICE_OFFLINE
  DEVICE_INACTIVITY
  USER_LOGIN
  USER_LOCKED
  CHECKLIST_SUBMITTED
  CHECKLIST_APPROVED
  CHECKLIST_REJECTED
  SYSTEM_ERROR
  // PM overdue deviation workflow (2026-06-03)
  PM_OVERDUE
  PM_OVERDUE_COMPLETED
  // PM schedule workflow QNN (Quality Notification Number) — 2026-06-08
  PM_SCHEDULE_QNN
  // Guest (unauthenticated) filter cleaning request — 2026-06-09
  GUEST_CLEANING_REQUEST
  // Report review/approval workflow — 2026-06-11
  REPORT_REVIEW_REQUESTED
  REPORT_REVIEW_APPROVED
  REPORT_REVIEW_REJECTED
  // Password expiry warnings — per-user daily warning window + expiry notice (2026-07-08)
  PASSWORD_EXPIRY_WARNING
  PASSWORD_EXPIRED_NOTICE
  // Cleaning stage interlock (QA approval after WASH_OUT/DRY_OUT) — 2026-06-12
  STAGE_APPROVAL_REQUESTED
  STAGE_APPROVAL_APPROVED
  STAGE_APPROVAL_REJECTED
}

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(200)
  message      String           @db.VarChar(1000)
  targetUserId String?          @map("target_user_id") @db.VarChar(50) // The user this notification is about
  forUserId    String?          @map("for_user_id") @db.VarChar(50) // The user who should see this (null = admins)
  forRole      String?          @map("for_role") @db.VarChar(50) // Role that should see this notification
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at") @db.Timestamptz
  metadata     Json?            @db.JsonB // Additional context data
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?          @map("created_by") @db.VarChar(50)
  manualEntry  Boolean          @default(false) @map("manual_entry") // manual data-mgmt insert

  @@index([forUserId])
  @@index([forRole])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@index([forUserId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// User-specific sidebar and feature configuration
model UserConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  sidebarItems Json     @default("[]") @map("sidebar_items") @db.JsonB // Array of enabled sidebar items
  homeWidgets  Json     @default("[]") @map("home_widgets") @db.JsonB // Array of enabled home widgets
  permissions  Json     @default("{}") @map("permissions") @db.JsonB // Feature-level permissions
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.VarChar(50)

  @@map("user_configs")
}

// Role-based default configuration
model RoleConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         String   @unique @db.VarChar(50) // References roles.name
  sidebarItems Json     @default("[]") @map("sidebar_items") @db.JsonB
  homeWidgets  Json     @default("[]") @map("home_widgets") @db.JsonB
  permissions  Json     @default("{}") @map("permissions") @db.JsonB
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.VarChar(50)

  @@map("role_configs")
}

// =============================================
// ASSET MANAGEMENT MODELS
// =============================================

// Lookup table for the canonical template families that the Filter Management
// / Cleaning Operations / Mobile pages resolve by code. Stored as a table (not
// a Prisma enum) so SUPER_ADMIN can add new kinds (e.g. PUMP, VALVE,
// COMPRESSOR) at runtime via the Configuration UI without a code migration.
//
// `code` is the stable, code-level identifier the frontend compares against
// (`templateKind === 'BLOCK'`). Pages route on code; admins can edit `label`
// for display.
//
// `isSystem=true` rows (BLOCK / AREA / AHU / FILTER / EQUIPMENT / OTHER —
// seeded by prisma/seed.ts) cannot be deleted and their `code` cannot be
// renamed; only `label`/`description`/`sortOrder`/`isActive` are admin-
// editable on system kinds. Non-system kinds are fully editable.
model TemplateKind {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.VarChar(50)
  updatedBy   String?  @map("updated_by") @db.VarChar(50)

  templates AssetTemplate[]

  @@index([isActive, sortOrder])
  @@map("template_kinds")
}

// ─── Typed Hierarchy Tables (Wave 1 of asset-removal, 2026-05-17) ──────────
// These mirror AssetInstance rows by template_kind via a Postgres trigger
// (`fn_mirror_asset_instance`). Reusing AssetInstance.id (UUID) so existing
// soft-FK columns like cleaning_cycles.filterId, filter_events.blockId, etc.
// continue to resolve. Reads can swap to these tables module-by-module behind
// a feature flag (Wave 5). AssetInstance / AssetTemplate remain authoritative
// until Wave 6 cutover.

model Block {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  status           String   @default("Active") @db.VarChar(50)
  attributes       Json     @default("{}") @db.JsonB
  customAttributes Json     @default("{}") @map("custom_attributes") @db.JsonB

  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.VarChar(50)
  updatedBy        String?  @map("updated_by") @db.VarChar(50)

  areas Area[]
  // A-01 T2.2: AHUs parented directly by a block (no area level).
  ahus  Ahu[]

  @@index([status])
  @@index([name])
  @@index([isActive])
  @@map("blocks")
}

model Area {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId          String?  @map("block_id") @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  status           String   @default("Active") @db.VarChar(50)
  attributes       Json     @default("{}") @db.JsonB
  customAttributes Json     @default("{}") @map("custom_attributes") @db.JsonB
 
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.VarChar(50)
  updatedBy        String?  @map("updated_by") @db.VarChar(50)

  block Block? @relation(fields: [blockId], references: [id])
  ahus  Ahu[]

  @@index([blockId])
  @@index([status])
  @@index([name])
  @@index([isActive])
  @@map("areas")
}

model Ahu {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  areaId           String?  @map("area_id") @db.Uuid
  blockId          String?  @map("block_id") @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  status           String   @default("Active") @db.VarChar(50)
  attributes       Json     @default("{}") @db.JsonB
  customAttributes Json     @default("{}") @map("custom_attributes") @db.JsonB
  
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.VarChar(50)
  updatedBy        String?  @map("updated_by") @db.VarChar(50)

  area    Area?    @relation(fields: [areaId], references: [id])
  block   Block?   @relation(fields: [blockId], references: [id])
  filters Filter[]

  @@index([areaId])
  @@index([blockId])
  @@index([status])
  @@index([name])
  @@index([isActive])
  @@map("ahus")
}

model Filter {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ahuId                 String?  @map("ahu_id") @db.Uuid
  name                  String   @db.VarChar(255)
  description           String?
  status                String   @default("Active") @db.VarChar(50)
  attributes            Json     @default("{}") @db.JsonB
  customAttributes      Json     @default("{}") @map("custom_attributes") @db.JsonB
  
  isActive              Boolean  @default(true) @map("is_active")
  // 2026-05-25 D-03 fix: the four mirror columns (filterProfileId,
  // currentLifecycleState, currentCycleId, filterSet) lived here as a
  // duplicate of FilterDetails. No application code ever read or wrote
  // them through prisma.filter.*, so they were pure drift hazard.
  // FilterDetails remains the authoritative source for cycle state.
  // When the asset cutover (A-01) lands and FilterDetails merges into
  // this model, re-add these columns then.
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy             String?  @map("created_by") @db.VarChar(50)
  updatedBy             String?  @map("updated_by") @db.VarChar(50)

  ahu Ahu? @relation(fields: [ahuId], references: [id])

  @@index([ahuId])
  @@index([status])
  @@index([name])
  @@index([isActive])
  @@map("filters")
}

// Asset Template — reusable blueprint for asset types
model AssetTemplate {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String   @unique @db.VarChar(100)
  description           String?  @db.VarChar(500)
  category              String   @default("General") @db.VarChar(50) // Equipment, Room, Building, etc.
  icon                  String   @default("box") @db.VarChar(50) // Icon identifier for UI
  templateKind          String   @default("OTHER") @map("template_kind") @db.VarChar(50) // FK code → TemplateKind.code (admin-editable lookup)
  version               Int      @default(1) // Current version number
  attributeSchema       Json     @default("[]") @map("attribute_schema") @db.JsonB // Array of attribute definitions
  telemetrySchema       Json     @default("[]") @map("telemetry_schema") @db.JsonB // Array of telemetry point definitions
  expectedIdentifiers   Json     @default("[]") @map("expected_identifiers") @db.JsonB // Array of expected identifier types
  expectedRelationships Json     @default("[]") @map("expected_relationships") @db.JsonB // Array of expected relationship types
  statusLifecycle       Json     @default("[]") @map("status_lifecycle") @db.JsonB // Array of status definitions with transitions
  checklistSchema       Json     @default("[]") @map("checklist_schema") @db.JsonB // Array of checklist question definitions
  maxParentConnections  Int      @default(1) @map("max_parent_connections") // Max CONTAINS parents: 0=none, 1+=limit
  maxConnections        Int      @default(10) @map("max_connections") // Max total connections (all types): 0=unlimited, N=limit
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy             String?  @map("created_by") @db.VarChar(50)
  updatedBy             String?  @map("updated_by") @db.VarChar(50)

  // ─── Data Ingestion Blueprint (Phase A) ────────────────
  dataIngestionEnabled Boolean @default(false) @map("data_ingestion_enabled")
  transportType        String? @map("transport_type") @db.VarChar(20) // MQTT | HTTP | WEBSOCKET
  credentialType       String? @default("TOKEN") @map("credential_type") @db.VarChar(20) // TOKEN | BASIC | X509
  inactivityTimeout    Int     @default(60) @map("inactivity_timeout") // seconds
  defaultMaxDataRate   Int     @default(600) @map("default_max_data_rate") // default rate limit for instances
  autoProvision        Boolean @default(true) @map("auto_provision") // auto-create credentials on instance creation

  versions              AssetTemplateVersion[]
  instances             AssetInstance[]
  templateAssignments   TemplateAssignment[]
  // May 16 H12 fix (2026-05-20): explicit onUpdate: Restrict. Was implicit
  // ON UPDATE CASCADE per Prisma default — a direct SQL `UPDATE template_kinds
  // SET code='NEW' WHERE code='OLD'` would silently rewrite the
  // template_kind column on EVERY asset_template row, breaking Filter
  // Management's resolution (admin UI doesn't expose this path but DB-level
  // operators / scripts could trigger it). RESTRICT forces explicit row
  // migration; safer for compliance.
  templateKindRef       TemplateKind                      @relation(fields: [templateKind], references: [code], onUpdate: Restrict)
  // Step 4 (2026-05-02): FilterProfile applicable-templates moved from JSONB
  // array on FilterProfile to a proper join table with cascade FKs. Deletes
  // are guarded server-side with 409 IN_USE if any FilterProfile binds this
  // template; the cascade is the safety net, not the user-facing path.
  filterProfileBindings FilterProfileApplicableTemplate[]

  @@index([isActive])
  @@index([category])
  @@index([templateKind])
  @@map("asset_templates")
}

// Asset Template Version — snapshot of template at a point in time
model AssetTemplateVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshot      Json     @db.JsonB // Full template snapshot at time of version
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.VarChar(50)

  template AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@map("asset_template_versions")
}

// Asset Instance — actual asset created from a template
model AssetInstance {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  templateId       String   @map("template_id") @db.Uuid
  templateVersion  Int      @default(1) @map("template_version") // Which version it was created from
  status           String   @default("Active") @db.VarChar(50) // Active, Inactive, Under Maintenance, Decommissioned
  attributes       Json     @default("{}") @db.JsonB // Key-value pairs with actual attribute values
  telemetryConfig  Json     @default("{}") @map("telemetry_config") @db.JsonB // Instance-level telemetry overrides
  customAttributes Json     @default("{}") @map("custom_attributes") @db.JsonB // Extra attributes added at instance level
  parentId         String?  @map("parent_id") @db.Uuid // Primary containment parent (for tree)
 
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.VarChar(50)
  updatedBy        String?  @map("updated_by") @db.VarChar(50)

  template          AssetTemplate       @relation(fields: [templateId], references: [id])
  // Wave 5 (2026-05-20) / May 16 H8 fix: was onDelete: SetNull. That meant
  // deleting a Block silently re-rooted every Area / AHU / Filter under it
  // (parent_id → NULL), losing the hierarchy context with no error. Restrict
  // forces the operator to detach children explicitly before delete.
  parent            AssetInstance?      @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          AssetInstance[]     @relation("AssetHierarchy")
  sourceRelations   AssetRelationship[] @relation("SourceAsset")
  targetRelations   AssetRelationship[] @relation("TargetAsset")
  identifiers       AssetIdentifier[]
  entityAssignments EntityAssignment[]
  equipmentGroups   EquipmentGroup[]

  // Filter-specific 1:1 split (Step 6 — 2026-05-01). FilterDetails is created
  // eagerly when the instance's template has templateKind='FILTER'. Other
  // template kinds never get a FilterDetails row.
  filterDetails FilterDetails?

  @@index([templateId])
  @@index([status])
  @@index([parentId])
  @@index([name])
  @@index([isActive])
  @@map("asset_instances")
}

// FilterDetails — 1:1 sidecar holding filter-specific cycle state.
// Split off AssetInstance in Step 6 (2026-05-01) because these fields are
// meaningless for non-filter rows and were leaking nullable state across
// every entity in the system.
model FilterDetails {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetInstanceId       String          @unique @map("asset_instance_id") @db.Uuid
  filterProfileId       String?         @map("filter_profile_id") @db.Uuid
  currentLifecycleState String?         @map("current_lifecycle_state") @db.VarChar(100)
  currentCycleId        String?         @map("current_cycle_id") @db.Uuid
  filterSet             FilterSetLabel? @map("filter_set")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  assetInstance AssetInstance  @relation(fields: [assetInstanceId], references: [id], onDelete: Cascade)
  filterProfile FilterProfile? @relation("FilterProfileFilterDetails", fields: [filterProfileId], references: [id])
  currentCycle  CleaningCycle? @relation("CurrentCycleFilterDetails", fields: [currentCycleId], references: [id])

  @@index([currentLifecycleState])
  @@index([currentCycleId])
  @@index([filterProfileId])
  @@map("filter_details")
}

// Step 2 (2026-05-01): converted from free-form String to a closed enum.
// Values mirror INVERSE_RELATIONSHIP_MAP in packages/shared/src/schemas/assets.ts.
// Bidirectional pair invariant is enforced by a deferred constraint trigger
// applied via apps/api/prisma/sql/invariants.sql at every reseed.
enum RelationshipType {
  CONTAINS
  CONTAINED_IN
  CONNECTED_TO
  FEEDS
  FED_BY
  DEPENDS_ON
  DEPENDED_ON_BY
  BACKS_UP
  BACKED_UP_BY
  MONITORS
  MONITORED_BY
  CUSTOM

  @@map("relationship_type_enum")
}

// Asset Relationship — bidirectional connections between assets
model AssetRelationship {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceAssetId    String           @map("source_asset_id") @db.Uuid
  targetAssetId    String           @map("target_asset_id") @db.Uuid
  relationshipType RelationshipType @map("relationship_type")
  customLabel      String?          @map("custom_label") @db.VarChar(100) // For CUSTOM type
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?          @map("created_by") @db.VarChar(50)
  updatedBy        String?          @map("updated_by") @db.VarChar(50)

  sourceAsset AssetInstance @relation("SourceAsset", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAsset AssetInstance @relation("TargetAsset", fields: [targetAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, targetAssetId, relationshipType])
  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@index([relationshipType])
  @@map("asset_relationships")
}

// Asset Identifier — physical identifiers (QR, RFID, NFC, Barcode, Manual)
model AssetIdentifier {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
