// ─── Filter Replacement Schedule (upload-driven, 2026-06-02) ───────────────
// Additive feature: a user uploads a schedule (one ReplacementSchedule batch);
// each row becomes a ReplacementScheduleEntry (AHU + filter spec + qty + date +
// ± tolerance window). Due entries surface as tablet My-Tasks; each filter
// actually replaced is logged as a ReplacementExecution (qty tracking + audit).
// AHU is a soft ref (no FK) to avoid coupling to the asset/typed-filter tables.
// The execute step WRAPS the existing replace action — it does not change it.
enum ReplacementEntryStatus {
  PENDING
  DUE
  IN_PROGRESS
  COMPLETED
  MISSED

  @@map("replacement_entry_status")
}

model ReplacementSchedule {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName       String?                    @map("file_name") @db.VarChar(255)
  status         String                     @default("ACTIVE") @db.VarChar(20) // ACTIVE | ARCHIVED
  notes          String?
  uploadedBy     String                     @map("uploaded_by") @db.Uuid
  uploadedByName String?                    @map("uploaded_by_name") @db.VarChar(255)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  entries        ReplacementScheduleEntry[]

  @@index([status])
  @@map("replacement_schedules")
}

model ReplacementScheduleEntry {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId    String                 @map("schedule_id") @db.Uuid
  slNo          Int?                   @map("sl_no")
  ahuId         String                 @map("ahu_id") @db.Uuid
  ahuName       String                 @map("ahu_name") @db.VarChar(255)
  filterMicron  String?                @map("filter_micron") @db.VarChar(100)
  filterSize    String?                @map("filter_size") @db.VarChar(100)
  qty           Int
  qtyReplaced   Int                    @default(0) @map("qty_replaced")
  scheduleDate  DateTime               @map("schedule_date") @db.Date
  toleranceDays Int                    @default(0) @map("tolerance_days")
  windowStart   DateTime               @map("window_start") @db.Date
  windowEnd     DateTime               @map("window_end") @db.Date
  status        ReplacementEntryStatus @default(PENDING)
  notes         String?

  // 3-step workflow (reuses the PM workflow config). approvalStatus defaults to
  // APPROVED so existing rows + workflow-off uploads stay live (current behaviour);
  // uploads land in PENDING_REVIEW only when the workflow is enabled. Distinct from
  // `status` (the DUE/IN_PROGRESS/COMPLETED execution lifecycle).
  approvalStatus  PmEntryApprovalStatus @default(APPROVED) @map("approval_status")
  approvalRemarks String?               @map("approval_remarks")
  submittedBy     String?               @map("submitted_by") @db.Uuid
  submittedByName String?               @map("submitted_by_name") @db.VarChar(255)
  reviewedBy      String?               @map("reviewed_by") @db.Uuid
  reviewedByName  String?               @map("reviewed_by_name") @db.VarChar(255)
  reviewedAt      DateTime?             @map("reviewed_at") @db.Timestamptz
  reviewRemarks   String?               @map("review_remarks")
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedByName  String?               @map("approved_by_name") @db.VarChar(255)
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz
  rejectedBy      String?               @map("rejected_by") @db.Uuid
  rejectedByName  String?               @map("rejected_by_name") @db.VarChar(255)
  rejectedAt      DateTime?             @map("rejected_at") @db.Timestamptz
  rejectionStage  String?               @map("rejection_stage") @db.VarChar(20)

  schedule      ReplacementSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  executions    ReplacementExecution[]

  @@index([scheduleId])
  @@index([ahuId])
  @@index([windowStart, windowEnd])
  @@index([status])
  @@map("replacement_schedule_entries")
}

model ReplacementExecution {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId         String                   @map("entry_id") @db.Uuid
  oldFilterId     String                   @map("old_filter_id") @db.Uuid
  newFilterId     String?                  @map("new_filter_id") @db.Uuid
  performedBy     String                   @map("performed_by") @db.Uuid
  performedByName String?                  @map("performed_by_name") @db.VarChar(255)
  isWithinWindow  Boolean                  @default(true) @map("is_within_window")
  remarks         String?
  performedAt     DateTime                 @default(now()) @map("performed_at") @db.Timestamptz

  entry           ReplacementScheduleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("replacement_executions")
}

// ─── PM Overdue Deviations (2026-06-03) ───────────────────────────────────
// When a PM cleaning task (PmScheduleEntry) passes its tolerance window without
// all of the AHU's counted filters cleaned, the overdue sweep opens ONE
// Deviation per entry (UNIQUE pm_schedule_entry_id → no daily duplicates). The
// ROW IS THE STATE MACHINE: OPEN → ACKNOWLEDGED (operator confirms with password
// on My Tasks) → CLOSED (all filters cleaned afterwards). Notifications fire once
// per transition, guarded by notified_at / completion_notified_at. Soft refs (no
// FK) — like ReplacementSchedule — so the deviation audit record survives
// schedule/entry deletion (21 CFR). Created via psql DDL (db push blocked).
enum DeviationStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED

  @@map("deviation_status")
}

model Deviation {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviationNumber      String          @unique @default(dbgenerated("('DEV-' || lpad((nextval('deviation_number_seq'))::text, 6, '0'))")) @map("deviation_number") @db.VarChar(40)
  pmScheduleEntryId    String          @unique @map("pm_schedule_entry_id") @db.Uuid // soft ref → PmScheduleEntry (the "task")
  ahuId                String          @map("ahu_id") @db.Uuid
  ahuName              String          @map("ahu_name") @db.VarChar(255)
  filterIds            Json            @default("[]") @map("filter_ids") @db.JsonB // string[] of filter ids counted at open
  filterCount          Int             @default(0) @map("filter_count")
  scheduledDate        DateTime        @map("scheduled_date") @db.Date
  windowStart          DateTime?       @map("window_start") @db.Date // tolerance window open (for self-contained closure predicate)
  windowEnd            DateTime        @map("window_end") @db.Date
  overdueDaysAtOpen    Int             @map("overdue_days_at_open") // now − scheduledDate at the moment the deviation opened
  assignedUserId       String?         @map("assigned_user_id") @db.Uuid
  status               DeviationStatus @default(OPEN)
  acknowledgedBy       String?         @map("acknowledged_by") @db.Uuid
  acknowledgedByName   String?         @map("acknowledged_by_name") @db.VarChar(255)
  acknowledgedAt       DateTime?       @map("acknowledged_at") @db.Timestamptz
  passwordVerified     Boolean         @default(false) @map("password_verified")
  notifiedAt           DateTime?       @map("notified_at") @db.Timestamptz // overdue-notification guard (fire once)
  completedBy          String?         @map("completed_by") @db.Uuid
  completedByName      String?         @map("completed_by_name") @db.VarChar(255)
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz
  delayDays            Int?            @map("delay_days") // completedAt − scheduledDate
  closedAt             DateTime?       @map("closed_at") @db.Timestamptz
  completionNotifiedAt DateTime?       @map("completion_notified_at") @db.Timestamptz // completion-notification guard
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([ahuId])
  @@index([createdAt(sort: Desc)])
  @@map("deviations")
}

model FilterCleaningProfile {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineageId            String                @map("lineage_id") @db.Uuid
  name                 String                @db.VarChar(255)
  description          String?
  flowMode             PipelineFlowMode      @default(STRICT) @map("flow_mode")
  alarmOnForwardSkip   Boolean               @default(true) @map("alarm_on_forward_skip")
