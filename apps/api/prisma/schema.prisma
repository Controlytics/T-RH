model FilterProfile {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String           @db.VarChar(255)
  description         String?
  cleaningProfileId   String           @map("cleaning_profile_id") @db.Uuid
  defaultPmScheduleId String?          @map("default_pm_schedule_id") @db.Uuid
  blockRestriction    BlockRestriction @default(OWN_BLOCK_ONLY) @map("block_restriction")
  allowedBlocks       Json?            @map("allowed_blocks") @db.JsonB
  maxCleaningCycles   Int?             @map("max_cleaning_cycles")
  isActive            Boolean          @default(true) @map("is_active")
  // Monotonic version counter — bumped on every mutation. Snapshot-then-bump
  // pattern (Phase A.3): the OUTGOING state is frozen into FilterProfileVersion
  // before the live row is updated, so audit replay can reconstruct the exact
  // mapping that was active at any historical moment.
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  cleaningProfile     FilterCleaningProfile?            @relation(fields: [cleaningProfileId], references: [id])
  pmSchedule          PmSchedule?                       @relation(fields: [defaultPmScheduleId], references: [id])
  filterDetails       FilterDetails[]                   @relation("FilterProfileFilterDetails")
  versions            FilterProfileVersion[]
  // Step 4 (2026-05-02): replaces the prior `applicableTemplates Json` array
  // on this row. Reads should `include: { applicableTemplates: { select: {
  // templateId: true } } }` and flatten so the API response shape stays
  // `applicableTemplates: string[]` and the FE doesn't need to change.
  applicableTemplates FilterProfileApplicableTemplate[]

  @@index([isActive])
  @@index([cleaningProfileId]) // audit 2026-06-08: FK lookup
  @@map("filter_profiles")
}

// Step 4 (2026-05-02): join table replacing FilterProfile.applicableTemplates
// JSONB array. Both FKs cascade-delete so a vanishing AssetTemplate or
// FilterProfile takes its bindings with it — no more dangling UUIDs in JSON.
// Server-side guard in template.service blocks AssetTemplate delete with
// 409 IN_USE if any FilterProfile still binds it; the cascade is the safety
// net, not the operator-visible path.
model FilterProfileApplicableTemplate {
  profileId  String   @map("profile_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile  FilterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  template AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([profileId, templateId])
  @@index([templateId])
  @@map("filter_profile_applicable_templates")
}

// Immutable historical snapshot of a FilterProfile at a specific version.
// Written BEFORE every mutation to the live profile (snapshot-then-bump, Phase A.3).
// FilterProfile drift cannot affect in-flight cycles because cycles already
// pin `cleaning_cycles.profileId` to a specific FilterCleaningProfile row at
// start, so no cycle-side pin map is needed here — versions exist purely for
// audit replay and admin history.
model FilterProfileVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Full snapshot of the live FilterProfile row: { name, description, cleaningProfileId,
  // applicableTemplates, defaultPmScheduleId, blockRestriction, allowedBlocks,
  // maxCleaningCycles, isActive }.
  snapshot      Json     @db.JsonB
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  profile FilterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNumber])
  @@index([profileId])
  @@map("filter_profile_versions")
}

model CleaningCycle {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleCode             String              @unique @map("cycle_code") @db.VarChar(100)
  filterId              String              @map("filter_id") @db.Uuid
  profileId             String              @map("profile_id") @db.Uuid
  profileVersion        Int                 @map("profile_version")
  sequenceNumber        Int                 @map("sequence_number")
  status                CleaningCycleStatus @default(IN_PROGRESS)
  startedAt             DateTime            @default(now()) @map("started_at") @db.Timestamptz
  completedAt           DateTime?           @map("completed_at") @db.Timestamptz
  terminatedAt          DateTime?           @map("terminated_at") @db.Timestamptz
  terminationReason     String?             @map("termination_reason")
  cleaningAreaId        String?             @map("cleaning_area_id") @db.Uuid
  pmExecutionId         String?             @map("pm_execution_id") @db.Uuid
  cleaningReasonKey     String              @map("cleaning_reason_key") @db.VarChar(100)
  cleaningReasonLabel   String              @map("cleaning_reason_label") @db.VarChar(255)
  cleaningJustification String?             @map("cleaning_justification")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  equipmentGroupId         String? @map("equipment_group_id") @db.Uuid
  // P1 (2026-05-02): pins the EquipmentGroup version in effect when this cycle
  // bound the group. Set at start-cycle (or at the first auto-bind, whichever
  // happens first). Reading validation reads operating-range from the pinned
  // EquipmentGroupVersion snapshot, NOT the live group, so admin edits to
  // ranges mid-cycle don't reach the in-flight cycle. Nullable so legacy
  // cycles + cycles that never bound a group fall back to the live row
  // (backwards compatible). Slice B (next APK) will add an
  // `expectedGroupVersion` field on submit-readings + 409 SCHEMA_DRIFT
  // self-heal flow on the tablet — see future/offline-version-sync-contract.md.
  equipmentGroupVersionPin Int?    @map("equipment_group_version_pin")

  // Dryer timing — tracks the dryer duration and start time for DRY_IN stage
  dryerDurationMinutes   Int?      @map("dryer_duration_minutes")
  dryerStartedAt         DateTime? @map("dryer_started_at") @db.Timestamptz
  dryerReadingsSubmitted Boolean   @default(false) @map("dryer_readings_submitted")

  // True for rows inserted manually via the SUPER_ADMIN data-management Create
  // tool (back-/future-dated records) — drives a "Manual entry" badge so they
  // are visually distinguishable from natively-captured records.
  manualEntry Boolean @default(false) @map("manual_entry")

  // Phase A.1: pinned ChecklistProfile versions at cycle start.
  // Shape: { [checklistProfileId: string]: versionNumber: int }
  // All checklist resolution during this cycle reads through these pins,
  // so admin edits to a profile mid-cycle do NOT change the questions or
  // required-flags the operator sees. Empty {} for legacy cycles started
  // before this column existed (fallback to live profile).
  checklistVersionPins Json @default("{}") @map("checklist_version_pins") @db.JsonB

  events              FilterEvent[]
  equipmentGroup      EquipmentGroup?        @relation(fields: [equipmentGroupId], references: [id])
  profile             FilterCleaningProfile? @relation(fields: [profileId], references: [id])
  activeFilterDetails FilterDetails[]        @relation("CurrentCycleFilterDetails")
  // Phase 5b.5 invariant (DB-side, not Prisma-expressible): at most ONE
  // IN_PROGRESS cycle per filter, enforced by partial unique index applied
  // via apps/api/prisma/sql/invariants.sql after every db push.

  @@index([filterId, status])
  @@index([status])
  @@index([startedAt])
  @@index([cleaningReasonKey])
  @@index([pmExecutionId])
  @@index([filterId, status, startedAt(sort: Desc)])
  @@index([equipmentGroupId]) // audit 2026-06-08: FK scanned on group edit/delete
  @@index([profileId])        // audit 2026-06-08: FK scanned on profile in-use checks
  @@map("cleaning_cycles")
}

model FilterEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filterId          String          @map("filter_id") @db.Uuid
  cycleId           String?         @map("cycle_id") @db.Uuid
  eventType         FilterEventType @map("event_type")
  fromState         String?         @map("from_state") @db.VarChar(100)
