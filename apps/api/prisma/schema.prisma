  cleaningAreaId    String?         @map("cleaning_area_id") @db.Uuid
  equipmentId       String?         @map("equipment_id") @db.Uuid
  blockId           String?         @map("block_id") @db.Uuid
  attributes        Json            @default("{}") @db.JsonB
  telemetrySnapshot Json            @default("{}") @map("telemetry_snapshot") @db.JsonB
  remarks           String?
  deviationDetails  Json?           @map("deviation_details") @db.JsonB
  manualEntry       Boolean         @default(false) @map("manual_entry") // manual data-mgmt insert
  checksum          String          @db.VarChar(64)
  ipAddress         String          @map("ip_address") @db.VarChar(45)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  cycle CleaningCycle? @relation(fields: [cycleId], references: [id])

  @@index([filterId, cycleId])
  @@index([performedAt])
  @@index([eventType, filterId])
  @@index([cycleId])
  @@index([filterId, cycleId, eventType])
  @@index([filterId, performedAt(sort: Desc)])
  @@map("filter_events")
}

// ─── Equipment Groups ──────────────────────────────────────

model EquipmentGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  blockId   String   @map("block_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  // Instrument auto-fetch (2026-06-13): ONE endpoint per group returns all
  // readings keyed by name under a `reading` object, e.g.
  //   { "reading": { "air_pressure": 6.2, "ro_water_pressure": 4.1, "dryer_temperature": 75 } }
  // Each instrument extracts its own value via EquipmentGroupInstrument.responseKey.
  readingUrl String? @map("reading_url") @db.VarChar(2048)
  // Monotonic version counter — bumped on every mutation of the group OR any of
  // its 3 instruments. Snapshot-then-bump pattern (Phase A.4): the OUTGOING
  // composite (group + all instruments) is frozen into EquipmentGroupVersion
  // before the live rows are updated, so admin-edit history is preserved.
  // Note: cycles do NOT pin a group version — operational drift is already
  // covered by FilterEvent.attributes.instrumentReadings (immutable snapshot
  // of description / instrumentCode / uom / leastCount / value at submit time).
  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  block       AssetInstance              @relation(fields: [blockId], references: [id])
  instruments EquipmentGroupInstrument[]
  cycles      CleaningCycle[]
  versions    EquipmentGroupVersion[]

  @@index([blockId])
  @@index([isActive])
  @@map("equipment_groups")
}

// Immutable historical snapshot of an EquipmentGroup at a specific version.
// Written BEFORE every mutation to the live group or any of its instruments
// (snapshot-then-bump, Phase A.4). The composite (group + 3 instruments) is
// always snapshotted together because update() mutates them as a unit.
model EquipmentGroupVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Full snapshot: { name, blockId, isActive, instruments: [{...full
  // EquipmentGroupInstrument shape, ordered by sortOrder...}] }
  snapshot      Json     @db.JsonB
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  group EquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, versionNumber])
  @@index([groupId])
  @@map("equipment_group_versions")
}

model EquipmentGroupInstrument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  description   String   @db.VarChar(255) // "Compressed Air Pressure", "RO Water Pressure", "Dryer Temperature"
  stageKey      String   @map("stage_key") @db.VarChar(100) // "WASH_IN" or "DRY_IN"
  serialNumber  String   @map("serial_number") @db.VarChar(100)
  instrumentId  String   @map("instrument_id") @db.VarChar(100)
  uom           String   @db.VarChar(50)
  instrumentMin Float    @map("instrument_min")
  instrumentMax Float    @map("instrument_max")
  operatingMin  Float    @map("operating_min")
  operatingMax  Float    @map("operating_max")
  leastCount    Float    @map("least_count")
  // Instrument auto-fetch (2026-06-13): the JSON key for THIS instrument inside
  // the group's reading endpoint response (e.g. "air_pressure"). autoFetchEnabled
  // is true iff the group has a readingUrl AND this instrument has a responseKey.
  // Both are snapshot-pinned into EquipmentGroupVersion. Missing = manual entry.
  responseKey      String?  @map("response_key") @db.VarChar(100)
  autoFetchEnabled Boolean  @default(false) @map("auto_fetch_enabled")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  group EquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@map("equipment_group_instruments")
}

// ─── Checklist Profiles & Questions ──────────────────────────

enum ChecklistQuestionType {
  YES_NO
  PASS_FAIL
  YES_NO_NA
  TEXT
  NUMERIC
  DROPDOWN
  MULTI_SELECT
  DATE_TIME
  PHOTO
  SIGNATURE
  CALCULATED
  CONDITIONAL

  @@map("checklist_question_type")
}

model ChecklistProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  // Monotonic version counter — bumped on every mutation of profile or its questions.
  // Cycles pin the version at start so answers always resolve against the schema
  // the operator actually saw, even if the live profile is edited later (Phase A.1).
  version     Int      @default(1)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  questions ChecklistQuestion[]
  versions  ChecklistProfileVersion[]

  @@index([isActive])
  @@map("checklist_profiles")
}

model ChecklistQuestion {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String                @map("profile_id") @db.Uuid
  question     String
  questionType ChecklistQuestionType @default(YES_NO) @map("question_type")
  required     Boolean               @default(false)
  section      String?               @db.VarChar(255)
  description  String?
  options      Json                  @default("[]") @db.JsonB
  validation   Json                  @default("{}") @db.JsonB
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  profile ChecklistProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("checklist_questions")
}

// Immutable historical snapshot of a checklist profile at a specific version.
// Created BEFORE every mutation to the live profile or its questions (snapshot-then-bump).
// Cycles store a pin map { profileId: versionNumber } and resolve questions through here
// so answers always reproduce against the schema that was active when the cycle started.
model ChecklistProfileVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Full snapshot: { name, description, isActive, questions: [...full ChecklistQuestion shape...] }
  snapshot      Json     @db.JsonB
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  profile ChecklistProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNumber])
  @@index([profileId])
  @@map("checklist_profile_versions")
}

enum BlockChangeStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("block_change_status")
}

model BlockChangeRequest {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filterId         String            @map("filter_id") @db.Uuid
  filterName       String            @map("filter_name") @db.VarChar(255)
  fromBlockId      String            @map("from_block_id") @db.Uuid
  fromBlockName    String            @map("from_block_name") @db.VarChar(255)
  toBlockId        String            @map("to_block_id") @db.Uuid
  toBlockName      String            @map("to_block_name") @db.VarChar(255)
  reason           String?
  status           BlockChangeStatus @default(PENDING)
  requestedBy      String            @map("requested_by") @db.Uuid
  requestedByName  String            @map("requested_by_name") @db.VarChar(255)
  processedBy      String?           @map("processed_by") @db.Uuid
  processedByName  String?           @map("processed_by_name") @db.VarChar(255)
  processedComment String?           @map("processed_comment")
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz
