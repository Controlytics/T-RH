# ===========================================
# DigiLog API .env  (apps/api/.env)
# Copy to .env and fill in the secrets marked CHANGE_ME.
# Loaded by `import 'dotenv/config'` at apps/api/src/app.ts:1.
# ===========================================
#
# Post Phase-7 (2026-06-17): the data-ingestion + TimescaleDB layer has been
# removed. There are no MQTT / TSDB / EMQX / UNS env keys anymore.

# ─── PostgreSQL (Prisma) ──────────────────────────────────
# Also used by graphile-worker — it shares the same DB.
DATABASE_URL=postgresql://digilog:CHANGE_ME@localhost:5432/digilog_db?schema=public

# ─── JWT Configuration ───────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Both REQUIRED in production; API exits fatally if missing or <32 chars.
JWT_SECRET=change-this-to-a-secure-random-string
VERIFICATION_TOKEN_SECRET=change-this-to-another-secure-random-string
# ─── Audit chain integrity (21 CFR §11.10(e)) ────────────────────────────────
# These two are a PAIR. Setting only the first leaves the chain forgeable.
#
# AUDIT_CHAIN_KEY — when set, new audit rows use keyed HMAC-SHA256
#   (checksum_version=3) so an actor with DB write access but no key cannot
#   forge the chain. Unset = unkeyed SHA-256, and because the checksum lives in
#   the same table it protects, a DB-level actor can recompute a fully
#   self-consistent forged chain that passes verify-chain.
#   MUST be stable + backed up OUTSIDE the database — losing or changing it
#   makes every v3 row permanently unverifiable.
#
# AUDIT_CHAIN_KEYED_FROM — the chain_position at which keying began. Every row
#   at/after it MUST be v3; verify-chain reports KEYED_ERA_DOWNGRADE otherwise.
#   Without this anchor a v3 row can be relabelled checksum_version=NULL,
#   recomputed with the unkeyed formula (no key needed), the forward chain
#   relinked, and verification still PASSES. Set it to 0 on a fresh install;
#   on an existing install set it to the CURRENT head position captured with
#   the API stopped (verify-chain reports highestPosition).
#
# Ordering matters. Stop API → read head → write BOTH vars → start API. Rows
# written between capturing the head and the key loading would land after the
# boundary as unkeyed, and verification would then fail permanently on a chain
# that was never tampered with.
#
# AUDIT_CHAIN_KEY=change-this-to-a-secure-random-string
# AUDIT_CHAIN_KEYED_FROM=0
# Audit 2026-05-29 S-8: default JWT TTL reduced from 8h → 1h.
# Override via JWT_EXPIRY_HOURS (integer hours, clamped at signToken).
JWT_EXPIRES_IN=1h

# ─── Server Configuration ────────────────────────────────
NODE_ENV=production
API_PORT=3000
# Run the API over TLS using certs/server.key + certs/server.crt.
# REQUIRED so the Android APK (built with VITE_API_URL=https://...) can connect.
API_HTTPS=true
# Set to 1 (or a hop-count) only when behind a known reverse proxy.
# Default false → req.ip uses the raw socket address (un-spoofable).
# TRUST_PROXY=1

# ─── CORS Configuration ──────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5175
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:3000

# ─── Upload Configuration ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ─── PDF rendering (Phase 3 of windows-friendly-rewrite) ──
# puppeteer-core + Edge auto-detected via detectEdgePath(). Set this only
# to override the auto-detected browser binary.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
