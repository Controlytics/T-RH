{
  "name": "digilog",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "cd apps/api && npx prisma migrate deploy",
    "db:verify-migrations": "powershell -NoProfile -File scripts/verify-migrations.ps1",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:studio": "cd apps/api && npx prisma studio",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@digilog/shared --filter=@digilog/api",
    "check:cycles": "madge --circular apps/api/src apps/web/src packages/shared/src packages/queue/src"
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "turbo": "^2.4.0"
  }
}
